---
// SearchBar.astro — Advanced search with fuzzy matching, voice search, smart filters, localStorage history
---

<div class="search-overlay" id="searchOverlay">
  <div class="search-modal">
    <div class="search-header">
      <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      <input type="text" id="searchInput" class="search-input" placeholder="Search jobs, results, services... (try 'ssc cg', 'railway', 'aadhaar')" autocomplete="off" autofocus />
      <button class="voice-btn" id="voiceBtn" title="Voice Search (Hindi/English)" aria-label="Voice search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
      </button>
      <kbd class="search-kbd">ESC</kbd>
    </div>
    <div class="search-filters">
      <button class="sf-btn active" data-filter="all">All</button>
      <button class="sf-btn" data-filter="job">Jobs</button>
      <button class="sf-btn" data-filter="result">Results</button>
      <button class="sf-btn" data-filter="service">Services</button>
      <button class="sf-btn" data-filter="admit-card">Admit Cards</button>
      <button class="sf-btn" data-filter="syllabus">Syllabus</button>
    </div>
    <div class="search-results" id="searchResults">
      <div class="search-empty">Type to search across 100+ pages...</div>
    </div>
    <div class="search-footer" id="searchFooter">
      <span class="search-footer-hint">↑↓ Navigate · Enter Select · Esc Close</span>
      <span class="search-footer-count" id="resultCount"></span>
    </div>
  </div>
</div>

