    { label: 'UPSC CSE Syllabus', url: '/syllabus/upsc-cse/', icon: '📚' },
    { label: 'Admit Cards', url: '/admit-cards/', icon: '🎫' },
    { label: 'Exam Calendar 2026', url: '/exam-calendar/', icon: '📅' },
    { label: 'Current Affairs', url: '/current-affairs/', icon: '📰' },
  ];

  function getRecentSearches() {
    try {
      return JSON.parse(localStorage.getItem('ss-recent-searches') || '[]');
    } catch (e) { return []; }
  }

  function saveRecentSearch(query) {
    if (!query || query.length < 2) return;
    try {
      let recent = getRecentSearches();
      recent = recent.filter(r => r.toLowerCase() !== query.toLowerCase());
      recent.unshift(query);
      recent = recent.slice(0, 8);
      localStorage.setItem('ss-recent-searches', JSON.stringify(recent));
    } catch (e) {}
  }

  function fuzzyMatch(text, query) {
    const t = text.toLowerCase();
    const q = query.toLowerCase();
    if (t.includes(q)) return { match: true, score: 100 - t.indexOf(q) };
    let qi = 0, score = 0, lastIdx = -1;
    for (let ti = 0; ti < t.length && qi < q.length; ti++) {
      if (t[ti] === q[qi]) {
        score += (lastIdx === ti - 1) ? 10 : 5;
        lastIdx = ti;
        qi++;
      }
    }
    return qi === q.length ? { match: true, score } : { match: false, score: 0 };
  }

  function highlightMatch(text, query) {
    if (!query) return text;
    const regex = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
    return text.replace(regex, '<mark>$1</mark>');
  }

  function showSuggestions() {
    const recent = getRecentSearches();
    let html = '';

    if (recent.length > 0) {
      html += `<div class="search-section">
        <div class="search-section-title">🕐 Recent Searches</div>
        ${recent.map(r => `
          <a href="/search?q=${encodeURIComponent(r)}" class="search-result-item" data-query="${r}">
            <span class="sri-icon">🕐</span>
            <div class="sri-info"><div class="sri-title">${r}</div></div>
            <button class="search-remove-btn" data-remove="${r}" title="Remove">×</button>
          </a>
        `).join('')}
      </div>`;
    }

    html += `<div class="search-section">
      <div class="search-section-title">🔥 Popular Searches</div>
      ${popularSearches.map(item => `
        <a href="${item.url}" class="search-result-item">
          <span class="sri-icon">${item.icon}</span>
          <div class="sri-info"><div class="sri-title">${item.label}</div></div>
        </a>
      `).join('')}
    </div>
    <div class="search-section">
      <div class="search-section-title">Quick Links</div>
      <a href="/latest-jobs/" class="search-result-item">
        <span class="sri-icon">💼</span>
        <div class="sri-info"><div class="sri-title">All Latest Jobs</div></div>
      </a>
      <a href="/results/" class="search-result-item">
        <span class="sri-icon">📊</span>
        <div class="sri-info"><div class="sri-title">All Results</div></div>
      </a>
      <a href="/syllabus/" class="search-result-item">
        <span class="sri-icon">📚</span>
        <div class="sri-info"><div class="sri-title">All Syllabus</div></div>
      </a>
      <a href="/tools/" class="search-result-item">
        <span class="sri-icon">🛠️</span>
        <div class="sri-info"><div class="sri-title">All Tools</div></div>
      </a>
    </div>`;

    results.innerHTML = html;
    resultCount.textContent = '';
    bindRemoveBtns();
  }

  function bindRemoveBtns() {
    results.querySelectorAll('.search-remove-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const val = btn.dataset.remove;
        try {
          let recent = getRecentSearches();
          recent = recent.filter(r => r !== val);
          localStorage.setItem('ss-recent-searches', JSON.stringify(recent));
          if (input.value.trim()) performSearch(input.value);
          else showSuggestions();
        } catch (e) {}
      });
    });
  }

  function openSearch() {
    overlay.classList.add('open');
    setTimeout(() => input.focus(), 100);
    document.body.classList.add('no-scroll');
    showSuggestions();
  }

  function closeSearch() {
    overlay.classList.remove('open');
    input.value = '';
    document.body.classList.remove('no-scroll');
    highlightedIndex = -1;
    currentResults = [];
  }

  function bindTriggers() {
    document.querySelectorAll('[data-search-trigger]').forEach(el => {
      el.addEventListener('click', openSearch);
    });
  }
  bindTriggers();
  document.addEventListener('DOMContentLoaded', bindTriggers);

  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); openSearch(); }
    if (e.key === 'Escape') closeSearch();
  });

  overlay.addEventListener('click', (e) => { if (e.target === overlay) closeSearch(); });

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeFilter = btn.dataset.filter;
      performSearch(input.value);
    });
  });

  input.addEventListener('input', (e) => { highlightedIndex = -1; performSearch(e.target.value); });

  input.addEventListener('keydown', (e) => {
    const items = results.querySelectorAll('.search-result-item');
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      highlightedIndex = Math.min(highlightedIndex + 1, items.length - 1);
      updateHighlight(items);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      highlightedIndex = Math.max(highlightedIndex - 1, 0);
      updateHighlight(items);
    } else if (e.key === 'Enter' && highlightedIndex >= 0) {
      e.preventDefault();
      const item = items[highlightedIndex];
      if (item && item.href) {
        saveRecentSearch(input.value.trim());
        window.location.href = item.href;
      }
    }
  });

  function updateHighlight(items) {
    items.forEach((item, i) => {
      item.classList.toggle('hl', i === highlightedIndex);
      if (i === highlightedIndex) item.scrollIntoView({ block: 'nearest' });
    });
  }

  function performSearch(query) {
    const q = query.trim();
    if (!q) { showSuggestions(); return; }

    const scored = SEARCH_DATA.map(item => {
      let score = 0;
      const titleMatch = fuzzyMatch(item.title, q);
      if (titleMatch.match) score += titleMatch.score * 2;
      const orgMatch = fuzzyMatch(item.org, q);
      if (orgMatch.match) score += orgMatch.score;
      const tagMatch = fuzzyMatch(item.tags, q);
      if (tagMatch.match) score += tagMatch.score;
      const matchFilter = activeFilter === 'all' || item.type === activeFilter;
      return { item, score, matchFilter };
    }).filter(r => r.score > 0 && r.matchFilter)
      .sort((a, b) => b.score - a.score);

    currentResults = scored;

    if (scored.length === 0) {
      const recent = getRecentSearches();
      let relatedHtml = '';
      if (recent.length > 0) {
        relatedHtml = `<div class="search-section"><div class="search-section-title">Try these recent searches</div>
          ${recent.slice(0, 3).map(r => `<a href="/search?q=${encodeURIComponent(r)}" class="search-result-item"><span class="sri-icon">🕐</span><div class="sri-info"><div class="sri-title">${r}</div></div></a>`).join('')}
        </div>`;
      }
      results.innerHTML = `
        <div class="search-empty">
          <div style="font-size:32px;margin-bottom:8px">🔍</div>
          <div>"<strong>${q}</strong>" ke liye kuch nahi mila</div>
          <div style="margin-top:4px;font-size:13px">Try different keywords ya check spelling</div>
        </div>
        ${relatedHtml}
        <div class="search-section">
          <div class="search-section-title">Latest Notifications</div>
          <a href="/latest-jobs/" class="search-result-item"><span class="sri-icon">💼</span><div class="sri-info"><div class="sri-title">Latest Govt Jobs</div></div></a>
          <a href="/results/" class="search-result-item"><span class="sri-icon">📊</span><div class="sri-info"><div class="sri-title">Check Results</div></div></a>
        </div>
      `;
      resultCount.textContent = '0 results';
      return;
    }

    const typeIcons = { job: '💼', result: '📊', service: '🏛️', 'admit-card': '🎫', syllabus: '📚' };
    const typeLabels = { job: 'Job', result: 'Result', service: 'Service', 'admit-card': 'Admit Card', syllabus: 'Syllabus' };

    results.innerHTML = scored.slice(0, 15).map(r => `
      <a href="${r.item.url}" class="search-result-item">
        <span class="sri-icon">${typeIcons[r.item.type]}</span>
        <div class="sri-info">
          <div class="sri-title">${highlightMatch(r.item.title, q)}</div>
          <div class="sri-meta">${r.item.org} · <span class="sri-type">${typeLabels[r.item.type]}</span>${r.item.state ? ' · ' + r.item.state : ''}${r.item.salary ? ' · ' + r.item.salary : ''}</div>
        </div>
      </a>
    `).join('');

    resultCount.textContent = `${scored.length} result${scored.length > 1 ? 's' : ''}`;
  }

  // Voice Search
  if (voiceBtn && ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window)) {
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    const recognition = new SpeechRecognition();
    recognition.continuous = false;
    recognition.interimResults = true;
    recognition.lang = 'hi-IN';

    let isListening = false;

    voiceBtn.addEventListener('click', () => {
      if (isListening) {
        recognition.stop();
        return;
      }
      isListening = true;
      voiceBtn.classList.add('listening');
      voiceBtn.title = 'Listening...';
      recognition.start();
    });

    recognition.onresult = (event) => {
      let transcript = '';
      for (let i = event.resultIndex; i < event.results.length; i++) {
        transcript += event.results[i][0].transcript;
      }
      input.value = transcript;
      performSearch(transcript);
    };

    recognition.onend = () => {
      isListening = false;
      voiceBtn.classList.remove('listening');
      voiceBtn.title = 'Voice Search (Hindi/English)';
    };

    recognition.onerror = () => {
      isListening = false;
      voiceBtn.classList.remove('listening');
      voiceBtn.title = 'Voice Search (Hindi/English)';
    };
  } else if (voiceBtn) {
    voiceBtn.style.display = 'none';
  }
})();
</script>

