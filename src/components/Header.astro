---
const currentPath = Astro.url.pathname;
const norm = (p: string) => p.replace(/\/+$/, '') || '/';
const currentNorm = norm(currentPath);

const isActive = (href: string) => {
  const h = norm(href);
  if (h === '/') return currentNorm === '/';
  return currentNorm === h || currentNorm.startsWith(h + '/');
};

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/results/', label: 'Results' },
  { href: '/admit-cards/', label: 'Admit Cards' },
  { href: '/latest-jobs/', label: 'Jobs' },
  { href: '/quiz/', label: 'Quiz' },
  { href: '/yojana/', label: 'Yojana' },
  { href: '/scholarship/', label: 'Scholarship' },
  { href: '/tools/', label: 'Tools' },
];

const dropdownLinks = [
  { href: '/cutoffs/', label: 'Cut-Off Marks' },
  { href: '/pyq/', label: 'PYQ Papers' },
  { href: '/current-affairs/', label: 'Current Affairs' },
  { href: '/syllabus/', label: 'Syllabus' },
  { href: '/answer-keys/', label: 'Answer Keys' },
  { href: '/exam-calendar/', label: 'Exam Calendar' },
  { href: '/national-services/', label: 'National Services' },
  { href: '/rajasthan-services/', label: 'Rajasthan Services' },
];

const isDropdownActive = dropdownLinks.some(d => isActive(d.href));
---

<header class="site-header" id="siteHeader">
  <div class="container header-inner">
    <a class="logo" href="/" aria-label="सरकारी सहायक — Home">
      <span class="logo-flag">🇮🇳</span>
      <span class="logo-text">
        <span class="logo-hi">सरकारी सहायक</span>
        <span class="logo-en">Govt Jobs · Salary Pitcher</span>
      </span>
    </a>

    <nav class="main-nav" aria-label="Main navigation">
      {navLinks.map(link => (
        <a href={link.href} class={isActive(link.href) ? 'active' : ''}>{link.label}</a>
      ))}
      <div class="nav-dropdown" id="servicesDropdownContainer">
        <button type="button" class={`dropdown-trigger ${isDropdownActive ? 'active' : ''}`} id="servicesDropdownTrigger" aria-expanded="false" aria-haspopup="true">
          Services <span class="caret">▾</span>
        </button>
        <div class="nav-dropdown-menu" id="servicesDropdown" role="menu">
          {dropdownLinks.map(link => (
            <a href={link.href} class={`dropdown-item ${isActive(link.href) ? 'active' : ''}`} role="menuitem">{link.label}</a>
          ))}
        </div>
      </div>
    </nav>

    <div class="head-actions">
      <button class="search-trigger" data-search-trigger aria-label="Search" title="Search (Ctrl+K)">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <span class="search-trigger-label">Search</span>
        <kbd class="search-trigger-kbd">⌘K</kbd>
      </button>
      <button class="icon-btn" id="themeToggle" aria-label="Light/Dark mode badlein" title="Theme badlein">☀️</button>
      <button class="hamburger" id="menuBtn" aria-label="मेनू खोलें" aria-expanded="false" aria-controls="mobileOverlay">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <div class="m-stripe"></div>
</header>

<div class="mobile-overlay" id="mobileOverlay" aria-hidden="true">
  <div class="m-stripe"></div>
  <div class="overlay-head">
    <span class="overlay-brand">Govt Jobs · Salary Pitcher</span>
    <button class="icon-close" id="menuClose" aria-label="मेनू बंद करें">✕</button>
  </div>
  <nav class="overlay-nav" aria-label="Mobile navigation">
    {navLinks.map((link, i) => (
      <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
        <span class="idx">{String(i + 1).padStart(2, '0')}</span>{link.label}
      </a>
    ))}
    <div class="overlay-section-title">Services & More</div>
    {dropdownLinks.map((link, i) => (
      <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
        <span class="idx">{String(navLinks.length + i + 1).padStart(2, '0')}</span>{link.label}
      </a>
    ))}
  </nav>
  <div class="overlay-foot">🇮🇳 जय हिन्द — Free Hindi Sarkari Guide · Session 2025-26</div>
</div>

<style>
  .nav-dropdown {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .dropdown-trigger {
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--body);
    padding: 6px 0;
    border-bottom: 2px solid transparent;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color .25s ease, border-color .25s ease;
  }
  .dropdown-trigger:hover,
  .dropdown-trigger.active,
  .nav-dropdown:hover .dropdown-trigger {
    color: var(--saffron);
    border-color: var(--saffron);
  }
  .nav-dropdown-menu {
    display: none;
    position: absolute;
    top: calc(100% + 4px);
    right: 0;
    background: var(--card);
    border: 1px solid var(--hairline);
    min-width: 210px;
    z-index: 1000;
    padding: 6px 0;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
  }
  .nav-dropdown:hover .nav-dropdown-menu,
  .nav-dropdown-menu.show {
    display: block;
  }
  .dropdown-item {
    display: block;
    padding: 9px 16px;
    font-size: 13.5px;
    font-family: var(--font-hindi);
    font-weight: 400;
    color: var(--strong);
    border-left: 3px solid transparent;
    transition: all .15s ease;
    text-decoration: none;
  }
  .dropdown-item:hover,
  .dropdown-item.active {
    background: rgba(255, 107, 53, 0.08);
    color: var(--saffron);
    border-left-color: var(--saffron);
  }
  .overlay-section-title {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--saffron);
    padding: 12px 0 4px;
    border-top: 1px solid var(--hairline-strong);
    margin-top: 8px;
  }
  .search-trigger {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 8px;
    background: var(--elevated);
    border: 1px solid var(--hairline);
    color: var(--muted);
    cursor: pointer;
    transition: all .15s ease;
    font-family: var(--font-hindi);
  }
  .search-trigger:hover {
    color: var(--strong);
    border-color: var(--saffron);
  }
  .search-trigger-label {
    font-size: 13px;
    font-weight: 500;
  }
  .search-trigger-kbd {
    font-size: 10px;
    padding: 1px 5px;
    border-radius: 3px;
    background: var(--card);
    border: 1px solid var(--hairline);
    font-family: monospace;
    color: var(--muted);
  }
  @media (max-width: 768px) {
    .search-trigger-label, .search-trigger-kbd {
      display: none;
    }
    .search-trigger {
      padding: 6px 8px;
    }
  }
</style>

<script is:inline>
(function () {
  var trigger = document.getElementById('servicesDropdownTrigger');
  var menu = document.getElementById('servicesDropdown');
  var container = document.getElementById('servicesDropdownContainer');
  if (!trigger || !menu) return;

  trigger.addEventListener('click', function (e) {
    e.preventDefault();
    e.stopPropagation();
    var isOpen = menu.classList.toggle('show');
    trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });

  document.addEventListener('click', function (e) {
    if (container && !container.contains(e.target)) {
      menu.classList.remove('show');
      trigger.setAttribute('aria-expanded', 'false');
    }
  });
})();
</script>
