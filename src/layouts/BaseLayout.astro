    <Footer />
  </slot>

  <div id="toastRoot" aria-live="polite"></div>
  <button id="backTop" aria-label="ऊपर जाएँ" title="Back to top">↑</button>
  <div id="printMount"></div>

  <script is:inline>
  (function () {
    'use strict';
    var docEl = document.documentElement;
    docEl.classList.remove('no-js');
    docEl.classList.add('js');
    var RM = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function toast(msg, type) {
      var root = document.getElementById('toastRoot');
      if (!root) return;
      var t = document.createElement('div');
      t.className = 'toast' + (type === 'info' ? ' t-info' : type === 'warn' ? ' t-warn' : '');
      t.textContent = msg;
      root.appendChild(t);
      setTimeout(function () { t.classList.add('bye'); }, 3400);
      setTimeout(function () { if (t.parentNode) t.parentNode.removeChild(t); }, 3900);
    }
    window._ssToast = toast;

    (function () {
      var btn = document.getElementById('themeToggle');
      if (!btn) return;
      function syncIcon() {
        var light = document.documentElement.getAttribute('data-theme') === 'light';
        btn.textContent = light ? '🌙' : '☀️';
        btn.setAttribute('aria-label', light ? 'Dark mode par jayein' : 'Light mode par jayein');
      }
      syncIcon();
      btn.addEventListener('click', function () {
        var cur = document.documentElement.getAttribute('data-theme');
        var next = cur === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('ss-theme', next); } catch (e) {}
        syncIcon();
        toast(next === 'light' ? 'Light mode on ☀️' : 'Dark mode on 🌙', 'info');
      });
    })();

    var backBtn = document.getElementById('backTop');
    window.addEventListener('scroll', function () {
      var y = window.scrollY || 0;
      var hdr = document.getElementById('siteHeader');
      if (hdr) hdr.classList.toggle('scrolled', y > 20);
      if (backBtn) backBtn.classList.toggle('show', y > 600);
    }, { passive: true });
    if (backBtn) {
      backBtn.addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: RM ? 'auto' : 'smooth' });
      });
    }

    var menuBtn = document.getElementById('menuBtn'),
        closeMenuBtn = document.getElementById('menuClose'),
        overlayEl = document.getElementById('mobileOverlay');
    function openMenu() {
      if (!overlayEl) return;
      overlayEl.classList.add('open'); overlayEl.setAttribute('aria-hidden', 'false');
      if (menuBtn) menuBtn.setAttribute('aria-expanded', 'true');
      document.body.classList.add('no-scroll');
    }
    function closeMenu() {
      if (!overlayEl) return;
      overlayEl.classList.remove('open'); overlayEl.setAttribute('aria-hidden', 'true');
      if (menuBtn) menuBtn.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('no-scroll');
    }
    if (menuBtn) menuBtn.addEventListener('click', openMenu);
    if (closeMenuBtn) closeMenuBtn.addEventListener('click', closeMenu);
    if (overlayEl) {
      Array.prototype.forEach.call(overlayEl.querySelectorAll('a'), function (a) {
        a.addEventListener('click', closeMenu);
      });
    }

    var revealEls = Array.prototype.slice.call(document.querySelectorAll('.reveal'));
    var io = null;
    if ('IntersectionObserver' in window && !RM) {
      io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          var el = entry.target, parent = el.parentElement, idx = 0;
          if (parent) {
            var sibs = Array.prototype.filter.call(parent.children, function (c) { return c.classList.contains('reveal'); });
            idx = sibs.indexOf(el);
          }
          setTimeout(function () { el.classList.add('in'); }, Math.min(Math.max(idx, 0) * 100, 600));
          io.unobserve(el);
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
      revealEls.forEach(function (el) { io.observe(el); });
    } else {
      revealEls.forEach(function (el) { el.classList.add('in'); });
    }
  })();
  </script>
