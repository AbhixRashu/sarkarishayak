---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us | Sarkari Sahayak 2026"
  description="Sarkari Sahayak se sampark karein — feedback, suggestions, content correction ya kisi bhi sawaal ke liye humein email karein."
  canonical="/contact/"
>
  <section class="section">
    <div class="container" style="max-width:800px">

      <div class="section-head center-head">
        <p class="section-label">Contact</p>
        <h1 class="section-title">Contact Us</h1>
        <p class="section-sub">Koi sawaal hai? Feedback dena chahte hain? Humse sampark karein.</p>
      </div>

      <!-- Quick Contact Cards -->
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:1rem; margin-top:var(--sp-lg); margin-bottom:var(--sp-xl);">
        <div class="ac-card" style="padding:1.25rem; text-align:center; border:1px solid rgba(255,255,255,0.08); border-radius:12px; background:rgba(255,255,255,0.02);">
          <div style="font-size:2rem; margin-bottom:0.5rem;">📧</div>
          <h3 style="font-size:1.1rem; margin-bottom:0.25rem; color:#fff;">Official Email</h3>
          <p style="font-size:0.9rem; color:#94a3b8; margin:0;"><a href="mailto:hello@sarkarishayak.online" style="color:#38bdf8; text-decoration:none;">hello@sarkarishayak.online</a></p>
          <span style="font-size:0.75rem; color:#64748b;">Response within 24-48 hrs</span>
        </div>

        <div class="ac-card" style="padding:1.25rem; text-align:center; border:1px solid rgba(255,255,255,0.08); border-radius:12px; background:rgba(255,255,255,0.02);">
          <div style="font-size:2rem; margin-bottom:0.5rem;">📍</div>
          <h3 style="font-size:1.1rem; margin-bottom:0.25rem; color:#fff;">Editorial Team</h3>
          <p style="font-size:0.9rem; color:#94a3b8; margin:0;">Jaipur, Rajasthan</p>
          <span style="font-size:0.75rem; color:#64748b;">India — 302001</span>
        </div>

        <div class="ac-card" style="padding:1.25rem; text-align:center; border:1px solid rgba(255,255,255,0.08); border-radius:12px; background:rgba(255,255,255,0.02);">
          <div style="font-size:2rem; margin-bottom:0.5rem;">⏰</div>
          <h3 style="font-size:1.1rem; margin-bottom:0.25rem; color:#fff;">Working Hours</h3>
          <p style="font-size:0.9rem; color:#94a3b8; margin:0;">Mon - Sat: 10 AM - 6 PM</p>
          <span style="font-size:0.75rem; color:#64748b;">Closed on National Holidays</span>
        </div>
      </div>

      <div class="tool-box" style="margin-top:var(--sp-xl)">
        <div class="tool-title">✉️ Send Message Directly</div>

        <form id="contactForm" novalidate>
          <div class="c-field" id="field-name">
            <label class="f-label" for="contact-name">Aapka Naam</label>
            <input type="text" class="c-input" id="contact-name" name="name" placeholder="Apna poora naam daalein" required>
            <span class="c-err">Kripya apna naam daalein.</span>
          </div>

          <div class="c-field" id="field-email">
            <label class="f-label" for="contact-email">Email Address</label>
            <input type="email" class="c-input" id="contact-email" name="email" placeholder="name@example.com" required>
            <span class="c-err">Kripya sahi email address daalein.</span>
          </div>

          <div class="c-field" id="field-topic">
            <label class="f-label" for="contact-topic">Vishay (Topic)</label>
            <select class="c-input" id="contact-topic" name="topic" required>
              <option value="" disabled selected>Topic chunein...</option>
              <option value="feedback">Feedback / Suggestion</option>
              <option value="bug">Bug Report / Website Issue</option>
              <option value="content">Content Request / Missing Guide</option>
              <option value="correction">Information Correction</option>
              <option value="collaboration">Collaboration / Partnership</option>
              <option value="other">Any Other</option>
            </select>
            <span class="c-err">Kripya ek topic chunein.</span>
          </div>

          <div class="c-field" id="field-message">
            <label class="f-label" for="contact-message">Aapka Sandesh (Message)</label>
            <textarea class="c-textarea" id="contact-message" name="message" placeholder="Apna sandesh yahan likhein..." rows="5" required></textarea>
            <span class="c-err">Kripya apna message daalein.</span>
          </div>

          <button type="submit" class="btn-primary" style="width:100%">Message Bhejein (Open Email Client) →</button>
        </form>
      </div>

      <div class="prose" style="margin-top:var(--sp-xl)">
        <div class="section-head">
          <p class="section-label">Email</p>
          <h2 class="section-title" style="font-size:28px">Seedha Email Karein</h2>
        </div>
        <p>
          Agar form use nahi karna chahte, toh aap seedha humare editorial email par sampark kar sakte hain:
        </p>
        <p style="font-size:16px">
          <strong>Email:</strong> <a href="mailto:hello@sarkarishayak.online" class="mini-link">hello@sarkarishayak.online</a>
        </p>
        <p>
          Hum <strong>24-48 ghante</strong> ke andar har genuine email ka javab dete hain.
        </p>
      </div>

      <div class="prose" style="margin-top:var(--sp-xl)">
        <div class="section-head">
          <p class="section-label">Guidelines</p>
          <h2 class="section-title" style="font-size:28px">Contact Guidelines</h2>
        </div>
        <ul>
          <li><strong>Clear Subject:</strong> Apne message mein topic ya exam/job ka naam clearly mention karein.</li>
          <li><strong>Official Queries:</strong> Sarkari pariksha ya form related queries ke liye official helpline par sampark karein — hum ek informational portal hain.</li>
          <li><strong>Corrections:</strong> Agar website par koi information galat ya outdated lage, toh notification link ke saath report karein taaki hum turant update karein.</li>
          <li><strong>No Promotional Spam:</strong> Commercial promotion ya paid backlinks ke spam emails ko ignore kiya jayega.</li>
        </ul>
      </div>

      <div class="disclaimer" style="margin-top:var(--sp-xl)">
        <span class="disc-icon">⚠️</span>
        <div class="disc-text">
          <strong>Note:</strong> Sarkari Sahayak ek independent informational portal hai. Hum kisi bhi sarkar ya government body ke official representative nahi hain.
        </div>
      </div>

    </div>
  </section>

  <script is:inline>
  (function () {
    var form = document.getElementById('contactForm');
    if (!form) return;

    function validateEmail(email) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    }

    function markErr(field, show) {
      var el = document.getElementById('field-' + field);
      if (el) el.classList.toggle('err', show);
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var name = document.getElementById('contact-name');
      var email = document.getElementById('contact-email');
      var topic = document.getElementById('contact-topic');
      var message = document.getElementById('contact-message');

      var valid = true;

      if (!name.value.trim()) { markErr('name', true); valid = false; } else { markErr('name', false); }
      if (!validateEmail(email.value)) { markErr('email', true); valid = false; } else { markErr('email', false); }
      if (!topic.value) { markErr('topic', true); valid = false; } else { markErr('topic', false); }
      if (!message.value.trim()) { markErr('message', true); valid = false; } else { markErr('message', false); }

      if (!valid) return;

      var subject = encodeURIComponent('[Sarkari Sahayak] ' + topic.value + ' - ' + name.value);
      var body = encodeURIComponent('Naam: ' + name.value + '\nEmail: ' + email.value + '\nTopic: ' + topic.value + '\n\nSandesh:\n' + message.value);
      
      // Open default email client
      window.location.href = 'mailto:hello@sarkarishayak.online?subject=' + subject + '&body=' + body;

      if (window._ssToast) {
        window._ssToast('Email client open ho raha hai... dhanyawad! 🎉', 'info');
      }
    });
  })();
  </script>
</BaseLayout>
