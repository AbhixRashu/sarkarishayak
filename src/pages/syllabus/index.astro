---
import BaseLayout from '../../layouts/BaseLayout.astro';
import syllabusData from '../../data/syllabus.json';

const siteUrl = 'https://govtjob.salarypitcher.com';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl + "/" },
    { "@type": "ListItem", "position": 2, "name": "Syllabus" }
  ]
};
---

<BaseLayout
  title="Exam Syllabus 2026 — SSC, IBPS, UPSC, RRB | Sarkari Sahayak"
  description="SSC CGL, IBPS Clerk, UPSC CSE, RRB NTPC sabke exam syllabus dekhein. Detailed topic-wise syllabus with book recommendations."
  canonical="/syllabus/"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <div class="section" style="padding-bottom:0">
    <div class="container">
      <nav style="font-size:13px;font-weight:300;color:var(--muted);letter-spacing:.5px" aria-label="Breadcrumb">
        <a href="/" style="color:var(--saffron);text-decoration:none">Home</a>
        <span style="margin:0 6px;color:var(--hairline)">/</span>
        <span style="color:var(--strong)">Syllabus</span>
      </nav>
    </div>
  </div>

  <div class="section" style="padding-top:var(--sp-lg)">
    <div class="container" style="max-width:800px;margin-inline:auto">
      <h1 class="d-title" style="font-size:28px;margin-bottom:8px">📚 Exam Syllabus 2026</h1>
      <p style="color:var(--body);font-size:16px;margin-bottom:24px">Major govt exams ke detailed syllabus aur recommended books.</p>

      <div class="syll-grid">
        {syllabusData.map(exam => (
          <a href={`/syllabus/${exam.id}/`} class="syll-card">
            <div class="syll-head">
              <h2 class="syll-title">{exam.exam}</h2>
              <span class="syll-level">{exam.level}</span>
            </div>
            <div class="syll-meta">
              <span>{exam.tiers} Tier{exam.tiers > 1 ? 's' : ''}</span>
              <span>•</span>
              <span>{exam.totalMarks} Marks</span>
              <span>•</span>
              <span>{exam.duration}</span>
            </div>
            <div class="syll-subjects">
              {exam.subjects.slice(0, 3).map(s => (
                <span class="syll-subject-tag">{s.name}</span>
              ))}
              {exam.subjects.length > 3 && <span class="syll-subject-tag">+{exam.subjects.length - 3} more</span>}
            </div>
            <div class="syll-cta">View Full Syllabus →</div>
          </a>
        ))}
      </div>
    </div>
  </div>

  <style>
    .syll-grid { display: grid; gap: 12px; }
    .syll-card {
      display: block; padding: 20px; background: var(--card);
      border: 1px solid var(--hairline); border-radius: 12px;
      text-decoration: none; transition: all .2s;
    }
    .syll-card:hover { border-color: var(--saffron); transform: translateY(-1px); }
    .syll-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
    .syll-title { font-family: var(--font-display); font-size: 18px; font-weight: 700; color: var(--strong); }
    .syll-level { font-size: 11px; padding: 2px 8px; border-radius: 4px; background: var(--elevated); color: var(--muted); }
    .syll-meta { font-size: 13px; color: var(--body); display: flex; gap: 6px; margin-bottom: 10px; }
    .syll-subjects { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px; }
    .syll-subject-tag {
      font-size: 12px; padding: 3px 10px; border-radius: 6px;
      background: var(--elevated); color: var(--body);
    }
    .syll-cta { font-size: 14px; font-weight: 600; color: var(--saffron); }
  </style>
</BaseLayout>
