---
import BaseLayout from '../../layouts/BaseLayout.astro';
import syllabusData from '../../data/syllabus.json';
import jobsData from '../../data/latest-jobs.json';

export function getStaticPaths() {
  const paths = [];
  const handledSlugs = new Set();

  // 1. All explicitly curated syllabi from syllabus.json
  for (const exam of syllabusData) {
    if (exam.id && !handledSlugs.has(exam.id)) {
      paths.push({
        params: { slug: exam.id },
        props: { exam, isJobSpecific: false }
      });
      handledSlugs.add(exam.id);
    }
  }

  // Helper function to synthesize subjects for any job based on title / category / qualification
  function generateJobSyllabus(job: any, slug: string) {
    const title = (job.title || job.shortTitle || 'Govt Exam').toLowerCase();
    const org = job.organization || 'Govt of India';
    const isTech = /engineer|je|ae|technical|polytechnic|diploma|iti|scientist|computer|programmer|assistant engineer|junior engineer/i.test(title);
    const isTeaching = /teacher|pgt|tgt|prt|faculty|professor|reet|ctet|tet/i.test(title);
    const isPolice = /police|constable|si|inspector|asi|security|daroga|commando/i.test(title);
    const isDefense = /defence|army|navy|airforce|agniveer|bsf|crpf|cisf|itbp|ssb/i.test(title);
    const isBanking = /bank|ibps|sbi|rbi|clerk|po|specialist officer/i.test(title);
    const isRajasthan = /rajasthan|rpsc|rssb|rvunl|jaipur|jodhpur|rspcb|rbse/i.test(title) || /rajasthan/i.test(org);

    const subjects = [];

    // Subject 1: Reasoning & Intelligence
    subjects.push({
      name: "General Intelligence & Reasoning",
      tier: "Tier 1 / CBT",
      questions: isTech ? 25 : 30,
      marks: isTech ? 50 : 60,
      topics: [
        "Analogies & Classification",
        "Coding-Decoding & Series",
        "Blood Relations & Direction Sense",
        "Syllogisms & Venn Diagrams",
        "Puzzles & Seating Arrangement",
        "Non-Verbal Reasoning & Figure Series"
      ]
    });

    // Subject 2: Quantitative Aptitude / Mathematics
    subjects.push({
      name: "Quantitative Aptitude & Mathematics",
      tier: "Tier 1 / CBT",
      questions: isTech ? 25 : 30,
      marks: isTech ? 50 : 60,
      topics: [
        "Number System & Simplification",
        "Percentage, Ratio & Proportion",
        "Profit, Loss & Discount",
        "Simple & Compound Interest",
        "Time & Work, Time & Distance",
        "Mensuration & Basic Algebra",
        "Data Interpretation (Charts & Graphs)"
      ]
    });

    // Subject 3: General Awareness / GK (Specialized for State if applicable)
    const gkTopics = [
      "Current Affairs (National & International)",
      "Indian Polity, Constitution & Governance",
      "History of India & National Movement",
      "Geography (Physical, Economic & Environmental)",
      "General Science (Physics, Chemistry, Biology)",
      "Economic Issues & Government Schemes"
    ];
    if (isRajasthan) {
      gkTopics.unshift("Rajasthan History, Art, Culture & Heritage", "Rajasthan Geography, Economy & Polity");
    }
    subjects.push({
      name: isRajasthan ? "General Awareness & Rajasthan GK" : "General Awareness & Current Affairs",
      tier: "Tier 1 / CBT",
      questions: isTech ? 25 : 30,
      marks: isTech ? 50 : 60,
      topics: gkTopics
    });

    // Subject 4: Language (English / Hindi)
    subjects.push({
      name: "General Hindi & English Language",
      tier: "Tier 1 / CBT",
      questions: 20,
      marks: 40,
      topics: [
        "Reading Comprehension & Cloze Test",
        "Grammar, Spotting Errors & Sentence Correction",
        "Synonyms, Antonyms & Idioms/Phrases",
        "Vyakaran (Sandhi, Samas, Muhavare, Vakya Shuddhi)",
        "One Word Substitution & Vocabulary"
      ]
    });

    // Subject 5: Technical / Professional Discipline if engineering/tech/teaching
    if (isTech) {
      subjects.push({
        name: "Concerned Engineering / Technical Discipline",
        tier: "Core Technical Section",
        questions: 60,
        marks: 120,
        topics: [
          "Core Domain Fundamentals & Principles",
          "Applied Mathematics & Engineering Concepts",
          "Design, Measurements & Instrumentation",
          "Safety Standards, Codes & Project Planning",
          "Practical Applications & Problem Solving"
        ]
      });
    } else if (isTeaching) {
      subjects.push({
        name: "Pedagogy, Child Development & Teaching Methodology",
        tier: "Domain Knowledge",
        questions: 30,
        marks: 60,
        topics: [
          "Child Development & Learning Principles",
          "Pedagogical Strategies & Curriculum Planning",
          "Educational Psychology & Classroom Management",
          "Inclusive Education & RTE Act Guidelines"
        ]
      });
    } else if (isPolice || isDefense) {
      subjects.push({
        name: "Physical & Mental Fitness, Law & Security Awareness",
        tier: "Stage 2 / PST/PET",
        questions: 20,
        marks: 40,
        topics: [
          "Basic Law, Human Rights & Police Regulations",
          "Internal Security & Disaster Management",
          "Physical Efficiency Test (PET) Benchmarks",
          "Medical & Physical Standards"
        ]
      });
    }

    const totalQuestions = subjects.reduce((sum, s) => sum + s.questions, 0);
    const totalMarks = subjects.reduce((sum, s) => sum + s.marks, 0);

    return {
      id: slug,
      exam: job.title || job.shortTitle || 'Govt Exam',
      organization: org,
      fullName: `${job.title || job.shortTitle || 'Govt'} Examination 2026`,
      level: job.qualify || 'Competitive Graduate / Diploma Level',
      tiers: isTech ? 2 : (isPolice ? 2 : 1),
      totalMarks: totalMarks,
      duration: isTech ? '120 Minutes (2 Hours)' : '90-120 Minutes',
      negativeMarking: '0.25 to 0.33 (1/3rd or 1/4th mark per incorrect answer)',
      subjects: subjects,
      books: [
        { name: "Lucent's General Knowledge (Latest 2026 Edition)", subject: "General Awareness" },
        { name: "Quantitative Aptitude by R.S. Aggarwal", subject: "Mathematics" },
        { name: "A Modern Approach to Verbal & Non-Verbal Reasoning (R.S. Aggarwal)", subject: "Reasoning" },
        { name: "General English / Samanya Hindi for Competitive Exams", subject: "Language" }
      ],
      jobRef: job
    };
  }

  // 2. Generate static paths for ALL jobs in latest-jobs.json (both exact slug & normalized slug)
  for (const job of jobsData) {
    if (!job.slug) continue;
    const baseSlug = job.slug.replace(/-20\d{2}$/, '');

    const slugsToProcess = [job.slug, baseSlug];

    for (const s of slugsToProcess) {
      if (s && !handledSlugs.has(s)) {
        // Try finding matching curated syllabus
        const match = syllabusData.find(ex =>
          s.includes(ex.id) ||
          ex.id.includes(s) ||
          (job.organization && ex.organization && ex.organization.toLowerCase() === job.organization.toLowerCase())
        );

        if (match) {
          paths.push({
            params: { slug: s },
            props: { exam: { ...match, id: s, exam: job.shortTitle || job.title || match.exam }, isJobSpecific: true }
          });
        } else {
          paths.push({
            params: { slug: s },
            props: { exam: generateJobSyllabus(job, s), isJobSpecific: true }
          });
        }
        handledSlugs.add(s);
      }
    }
  }

  return paths;
}

const { exam, isJobSpecific } = Astro.props;

// Total topics across all subjects — used by the interactive study tracker
const syllTotalTopics = (exam.subjects || []).reduce((n, s) => n + ((s.topics || []).length), 0);
const syllStorageKey = `ss_syll_progress_${exam.id || 'exam'}`;
const siteUrl = 'https://govtjob.salarypitcher.com';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl + "/" },
    { "@type": "ListItem", "position": 2, "name": "Syllabus", "item": siteUrl + "/syllabus/" },
    { "@type": "ListItem", "position": 3, "name": exam.exam }
  ]
};

const faqEntity = (exam.subjects || []).slice(0, 3).map(s => {
  const topicList = (s.topics || []).join(', ');
  return {
    "@type": "Question",
    "name": `${exam.exam} mein ${s.name} ka syllabus kya hai?`,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": `${s.name} mein ${topicList} jaise topics cover hote hain. Total ${s.questions} questions aate hain (${s.marks} marks).`
    }
  };
});

// Add extra common FAQs
faqEntity.push({
  "@type": "Question",
  "name": `${exam.exam} mein negative marking hoti hai kya?`,
  "acceptedAnswer": {
    "@type": "Answer",
    "text": `Haan, ${exam.exam} mein negative marking ka niyam lagoo hota hai: ${exam.negativeMarking || '1/3rd ya 1/4th marks kaate jaate hain galat uttar par'}.`
  }
});

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqEntity
};
---

<BaseLayout
  title={`${exam.exam} Syllabus 2026 — Topic-Wise Exam Pattern & Marking Scheme | Sarkari Sahayak`}
  description={`${exam.exam} complete syllabus with subject & topic-wise breakdown. ${exam.organization} exam: ${exam.totalMarks} marks, ${exam.duration}. Best books & preparation tips.`}
  canonical={`/syllabus/${exam.id}/`}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumb -->
  <div class="section" style="padding-bottom:0">
    <div class="container">
      <nav style="font-size:13px;font-weight:300;color:var(--muted);letter-spacing:.5px" aria-label="Breadcrumb">
        <a href="/" style="color:var(--saffron);text-decoration:none">Home</a>
        <span style="margin:0 6px;color:var(--hairline)">/</span>
        <a href="/syllabus/" style="color:var(--saffron);text-decoration:none">Syllabus</a>
        <span style="margin:0 6px;color:var(--hairline)">/</span>
        <span style="color:var(--strong)">{exam.exam}</span>
      </nav>
    </div>
  </div>

  <div class="section" style="padding-top:var(--sp-lg)">
    <div class="container" style="max-width:880px;margin-inline:auto">

      <!-- Header -->
      <div class="d-header">
        <div class="d-icon">📚</div>
        <div>
          <h1 class="d-title">{exam.exam} Syllabus 2026</h1>
          <div class="d-sub">{exam.fullName || exam.exam} · {exam.organization}</div>
        </div>
      </div>

      <!-- Quick Action / Related Job Banner if job-specific -->
      {exam.jobRef && (
        <div class="syll-job-banner">
          <div class="sjb-icon">💼</div>
          <div class="sjb-info">
            <strong>{exam.exam} — Official Recruitment 2026</strong>
            <span>Check application dates, eligibility, vacancy details and online apply link.</span>
          </div>
          <a href={`/latest-jobs/${exam.jobRef.slug}/`} class="btn-primary" style="height:36px;padding:0 16px;font-size:12px;white-space:nowrap">
            View Job Details →
          </a>
        </div>
      )}

      <!-- Overview Grid -->
      <div class="syll-overview">
        <div class="syll-ov-item">
          <div class="syll-ov-label">Level</div>
          <div class="syll-ov-value">{exam.level || 'Graduate / 12th'}</div>
        </div>
        <div class="syll-ov-item">
          <div class="syll-ov-label">Tiers / Stages</div>
          <div class="syll-ov-value">{exam.tiers} Stage{exam.tiers > 1 ? 's' : ''}</div>
        </div>
        <div class="syll-ov-item">
          <div class="syll-ov-label">Total Marks</div>
          <div class="syll-ov-value">{exam.totalMarks} Marks</div>
        </div>
        <div class="syll-ov-item">
          <div class="syll-ov-label">Exam Duration</div>
          <div class="syll-ov-value">{exam.duration}</div>
        </div>
        <div class="syll-ov-item" style="grid-column:1/-1">
          <div class="syll-ov-label">Negative Marking</div>
          <div class="syll-ov-value" style="font-size:15px;color:var(--saffron)">{exam.negativeMarking}</div>
        </div>
      </div>

      <!-- Subject-wise Syllabus — Interactive Study Tracker -->
      <h2 class="d-h" style="margin-bottom:14px">Subject-wise Syllabus &amp; Exam Pattern</h2>

      <div class="syll-tracker">
        <div class="syll-tracker-top">
          <span class="syll-tracker-label">🎯 Aapki preparation progress</span>
          <span class="syll-tracker-text" data-syll-progress-text>0 / {syllTotalTopics} topics</span>
        </div>
        <div class="syll-tracker-bar"><span class="syll-tracker-fill" data-syll-progress-fill></span></div>
        <div class="syll-tracker-actions">
          <button type="button" class="syll-mini" data-syll-expand>⌄ Expand all</button>
          <button type="button" class="syll-mini" data-syll-collapse>⌃ Collapse all</button>
          <button type="button" class="syll-mini syll-mini-warn" data-syll-reset>↺ Reset progress</button>
        </div>
      </div>

      <input
        type="search"
        class="syll-search"
        data-syll-search
        placeholder="🔍 Search topic — e.g. Percentage, Reasoning, Hindi..."
        aria-label="Search syllabus topic"
      />

      <div class="syll-subjects-list">
        {exam.subjects && exam.subjects.map((subject, i) => (
          <div class="syll-subject open" data-syll-subj>
            <button type="button" class="syll-subject-head" data-syll-subj-toggle aria-expanded="true">
              <span class="syll-subject-name">{subject.name}</span>
              <span class="syll-subject-meta">{subject.questions} Qs · {subject.marks} Marks · {subject.tier}</span>
              <span class="syll-subject-count" data-syll-subj-count>0/{(subject.topics || []).length}</span>
              <span class="syll-caret">▾</span>
            </button>
            <div class="syll-topics" data-syll-subj-body>
              {subject.topics && subject.topics.map((topic, ti) => (
                <button type="button" class="syll-topic" data-syll-topic data-key={`s${i}t${ti}`}>
                  <span class="syll-tick">○</span>
                  <span class="syll-topic-text">{topic}</span>
                </button>
              ))}
            </div>
          </div>
        ))}
      </div>
      <p class="syll-empty" data-syll-empty hidden>Koi topic match nahi hua — dusra keyword try karo.</p>
      <p class="syll-hint">💡 Tip: Topic par tap karke tick karo — progress apne device mein save ho jata hai, kal wapas aake dekh sakte ho.</p>

      <!-- Recommended Books -->
      {exam.books && exam.books.length > 0 && (
        <div style="margin-top:28px">
          <h2 class="d-h" style="margin-bottom:14px">Recommended Books & Study Material</h2>
          <div class="syll-books">
            {exam.books.map(book => (
              <div class="syll-book">
                <span class="syll-book-name">📖 {book.name}</span>
                <span class="syll-book-subject">{book.subject}</span>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Preparation Tips -->
      <div class="d-section" style="margin-top:28px">
        <h2 class="d-h" style="margin-bottom:14px">Preparation Strategy & Tips</h2>
        <div class="steps-box">
          <ul style="list-style:none;padding:0;margin:0">
            <li style="padding:10px 0;border-bottom:1px solid var(--hairline);font-size:14px">📌 <strong>Syllabus Analysis:</strong> Sabse pehle exam pattern aur topic weightage ko achhi tarah samajhein.</li>
            <li style="padding:10px 0;border-bottom:1px solid var(--hairline);font-size:14px">📝 <strong>Previous Year Question Papers (PYQs):</strong> Pichle 5 saal ke question papers solve karein taaki exam trend samajh aaye.</li>
            <li style="padding:10px 0;border-bottom:1px solid var(--hairline);font-size:14px">⏰ <strong>Time Management:</strong> Daily time-table banakar sabhi subjects (Reasoning, Math, GK, Language) ko samay dein.</li>
            <li style="padding:10px 0;border-bottom:1px solid var(--hairline);font-size:14px">📊 <strong>Weekly Mock Tests:</strong> Har hafte kam se kam 1-2 online mock tests dein aur weak areas ka analysis karein.</li>
            <li style="padding:10px 0;font-size:14px">📰 <strong>Current Affairs & Revision:</strong> Rozana national aur state current affairs padhein aur short notes banayein.</li>
          </ul>
        </div>
      </div>

      <!-- Related Navigation Links -->
      <div class="syll-related-links">
        <h3 class="srl-title">सम्बंधित पेज व टूल्स</h3>
        <div class="srl-grid">
          <a href="/cutoffs/" class="srl-item">
            <span class="srl-icon">📊</span>
            <span>Cut-Off Marks</span>
          </a>
          <a href="/pyq/" class="srl-item">
            <span class="srl-icon">📑</span>
            <span>Previous Year Papers</span>
          </a>
          <a href="/latest-jobs/" class="srl-item">
            <span class="srl-icon">💼</span>
            <span>Latest Jobs</span>
          </a>
          <a href="/admit-cards/" class="srl-item">
            <span class="srl-icon">🎫</span>
            <span>Admit Cards</span>
          </a>
          <a href="/results/" class="srl-item">
            <span class="srl-icon">✅</span>
            <span>Exam Results</span>
          </a>
          <a href="/quiz/" class="srl-item">
            <span class="srl-icon">🎯</span>
            <span>Practice Quiz</span>
          </a>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="d-section" style="margin-top:28px">
        <h2 class="d-h" style="margin-bottom:14px">Frequently Asked Questions (FAQ)</h2>
        <div class="faq-list">
          {faqEntity.map(faq => (
            <details class="faq-item">
              <summary class="faq-quest">{faq.name}</summary>
              <p class="faq-ans">{faq.acceptedAnswer.text}</p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </div>

  <style>
    .syll-job-banner {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 14px 18px;
      background: linear-gradient(135deg, rgba(28,105,212,0.08) 0%, rgba(235,94,40,0.08) 100%);
      border: 1px solid var(--hairline);
      border-radius: 12px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }
    .sjb-icon { font-size: 24px; }
    .sjb-info { flex: 1; min-width: 220px; display: flex; flex-direction: column; gap: 2px; }
    .sjb-info strong { color: var(--strong); font-size: 14px; }
    .sjb-info span { color: var(--muted); font-size: 12px; }

    .syll-overview {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 10px;
      margin-bottom: 24px;
    }
    .syll-ov-item {
      padding: 14px;
      background: var(--card);
      border: 1px solid var(--hairline);
      border-radius: 10px;
      text-align: center;
    }
    .syll-ov-label { font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--muted); letter-spacing: .5px; }
    .syll-ov-value { font-family: var(--font-display); font-size: 17px; font-weight: 700; color: var(--strong); margin-top: 4px; }

    .syll-subjects-list { display: grid; gap: 10px; }
    .syll-subject {
      background: var(--card);
      border: 1px solid var(--hairline);
      border-radius: 10px;
      overflow: hidden;
    }
    .syll-subject-head {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 16px;
      cursor: pointer;
      list-style: none;
      flex-wrap: wrap;
      gap: 8px;
      background: transparent;
      border: none;
      text-align: left;
    }
    .syll-subject-head::-webkit-details-marker { display: none; }
    .syll-subject-head::before { content: '▸ '; color: var(--saffron); }
    .syll-subject.open .syll-subject-head::before { content: '▾ '; }
    .syll-subject-name { font-weight: 700; color: var(--strong); font-size: 15px; }
    .syll-subject-meta { font-size: 12px; color: var(--muted); }
    .syll-subject-count {
      font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 999px;
      background: var(--elevated); color: var(--saffron); border: 1px solid var(--hairline);
    }
    .syll-caret { font-size: 12px; color: var(--muted); transition: transform .2s ease; }
    .syll-subject:not(.open) .syll-caret { transform: rotate(-90deg); }
    .syll-topics {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      padding: 0 16px 14px;
    }
    .syll-subject:not(.open) .syll-topics { display: none; }
    .syll-topic {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      padding: 5px 11px;
      border-radius: 6px;
      background: var(--elevated);
      color: var(--body);
      border: 1px solid var(--hairline);
      cursor: pointer;
      transition: all .15s ease;
    }
    .syll-topic:hover { border-color: var(--saffron); transform: translateY(-1px); }
    .syll-topic.done {
      background: rgba(14, 124, 90, .12);
      border-color: #0e7c5a;
      color: #0e7c5a;
      text-decoration: line-through;
    }
    .syll-tick { font-size: 11px; font-weight: 700; }

    /* Interactive study tracker */
    .syll-tracker {
      margin: 0 0 12px;
      padding: 12px 14px;
      background: var(--elevated);
      border: 1px solid var(--hairline);
      border-radius: 12px;
    }
    .syll-tracker-top {
      display: flex; justify-content: space-between; align-items: center;
      font-size: 12.5px; font-weight: 600; color: var(--strong); gap: 8px; flex-wrap: wrap;
    }
    .syll-tracker-bar {
      height: 8px; border-radius: 999px; background: var(--hairline);
      overflow: hidden; margin: 8px 0 10px;
    }
    .syll-tracker-fill {
      display: block; height: 100%; width: 0%;
      background: linear-gradient(90deg, #0e7c5a, #f0b429); transition: width .25s ease;
    }
    .syll-tracker-actions { display: flex; gap: 8px; flex-wrap: wrap; }
    .syll-mini {
      font-size: 11.5px; padding: 5px 10px; border-radius: 8px;
      border: 1px solid var(--hairline); background: var(--card);
      color: var(--body); cursor: pointer;
    }
    .syll-mini:hover { border-color: var(--saffron); color: var(--strong); }
    .syll-mini-warn:hover { border-color: #d9534f; color: #d9534f; }
    .syll-search {
      width: 100%; padding: 11px 14px; border-radius: 10px; margin-bottom: 12px;
      border: 1px solid var(--hairline); background: var(--card);
      color: var(--strong); font-size: 14px;
    }
    .syll-empty { font-size: 13px; color: var(--muted); text-align: center; padding: 12px; }
    .syll-hint { font-size: 12px; color: var(--muted); margin: 10px 0 0; }

    .syll-books { display: grid; gap: 8px; }
    .syll-book {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      background: var(--card);
      border: 1px solid var(--hairline);
      border-radius: 8px;
      gap: 10px;
      flex-wrap: wrap;
    }
    .syll-book-name { font-size: 14px; font-weight: 600; color: var(--strong); }
    .syll-book-subject { font-size: 12px; padding: 2px 8px; border-radius: 4px; background: var(--elevated); color: var(--saffron); }

    .steps-box {
      background: var(--card);
      border: 1px solid var(--hairline);
      border-radius: 10px;
      padding: 16px 20px;
    }

    .syll-related-links {
      background: var(--card);
      border: 1px solid var(--hairline);
      border-radius: 12px;
      padding: 20px;
      margin-top: 28px;
    }
    .srl-title { font-size: 16px; font-weight: 700; color: var(--strong); margin-bottom: 12px; }
    .srl-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
      gap: 10px;
    }
    .srl-item {
      display: flex;
      align-items: center;
      gap: 8px;
      background: var(--elevated);
      border: 1px solid var(--hairline);
      border-radius: 8px;
      padding: 10px 12px;
      color: var(--strong);
      text-decoration: none;
      font-size: 13px;
      font-weight: 500;
      transition: all .2s;
    }
    .srl-item:hover {
      border-color: var(--saffron);
      color: var(--saffron);
      transform: translateY(-1px);
    }
    .srl-icon { font-size: 16px; }

    .faq-list { display: grid; gap: 10px; }
    .faq-item {
      background: var(--card);
      border: 1px solid var(--hairline);
      border-radius: 8px;
      padding: 12px 16px;
    }
    .faq-quest { font-weight: 600; color: var(--strong); cursor: pointer; }
    .faq-ans { margin-top: 8px; color: var(--body); font-size: 14px; line-height: 1.6; }
  </style>

  <script is:inline define:vars={{ syllKey: syllStorageKey }}>
  (function () {
    var KEY = syllKey;
    var widget = document.querySelector('.syll-tracker');
    if (!widget) return;

    var topics = Array.prototype.slice.call(document.querySelectorAll('[data-syll-topic]'));
    var subjects = Array.prototype.slice.call(document.querySelectorAll('[data-syll-subj]'));
    var fill = document.querySelector('[data-syll-progress-fill]');
    var text = document.querySelector('[data-syll-progress-text]');
    var search = document.querySelector('[data-syll-search]');
    var empty = document.querySelector('[data-syll-empty]');

    function load() { try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) { return []; } }
    function persist(arr) { try { localStorage.setItem(KEY, JSON.stringify(arr)); } catch (e) {} }
    var done = load();

    function paint() {
      var total = topics.length;
      var count = 0;
      topics.forEach(function (t) {
        var isDone = done.indexOf(t.getAttribute('data-key')) >= 0;
        t.classList.toggle('done', isDone);
        var tick = t.querySelector('.syll-tick');
        if (tick) tick.textContent = isDone ? '✓' : '○';
        if (isDone) count++;
      });
      subjects.forEach(function (s) {
        var all = s.querySelectorAll('[data-syll-topic]').length;
        var d = s.querySelectorAll('[data-syll-topic].done').length;
        var badge = s.querySelector('[data-syll-subj-count]');
        if (badge) badge.textContent = d + '/' + all;
      });
      if (fill) fill.style.width = total ? ((count / total) * 100) + '%' : '0%';
      if (text) text.textContent = count + ' / ' + total + ' topics' + (total && count === total ? ' 🎉 Sab ho gaya!' : '');
    }

    document.addEventListener('click', function (e) {
      var t = e.target;

      var topic = t.closest('[data-syll-topic]');
      if (topic) {
        var k = topic.getAttribute('data-key');
        var i = done.indexOf(k);
        if (i >= 0) { done.splice(i, 1); } else { done.push(k); }
        persist(done);
        paint();
        return;
      }

      var head = t.closest('[data-syll-subj-toggle]');
      if (head) {
        var subj = head.closest('[data-syll-subj]');
        var isOpen = subj.classList.toggle('open');
        head.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        return;
      }

      if (t.closest('[data-syll-expand]')) { subjects.forEach(function (s) { s.classList.add('open'); }); return; }
      if (t.closest('[data-syll-collapse]')) { subjects.forEach(function (s) { s.classList.remove('open'); }); return; }
      if (t.closest('[data-syll-reset]')) {
        if (window.confirm('Saari preparation progress reset kar dein?')) { done = []; persist(done); paint(); }
      }
    });

    if (search) search.addEventListener('input', function () {
      var q = search.value.trim().toLowerCase();
      var anyVisible = false;
      subjects.forEach(function (s) {
        var nameEl = s.querySelector('.syll-subject-name');
        var nameMatch = nameEl ? nameEl.textContent.toLowerCase().indexOf(q) >= 0 : false;
        var topicEls = Array.prototype.slice.call(s.querySelectorAll('[data-syll-topic]'));
        var visible = 0;
        topicEls.forEach(function (t) {
          var txt = (t.textContent || '').toLowerCase();
          var match = !q || nameMatch || txt.indexOf(q) >= 0;
          t.style.display = match ? '' : 'none';
          if (match) visible++;
        });
        var show = !q || nameMatch || visible > 0;
        s.style.display = show ? '' : 'none';
        if (q && show) s.classList.add('open');
        if (show) anyVisible = true;
      });
      if (empty) empty.hidden = anyVisible;
    });

    paint();
  })();
  </script>
</BaseLayout>
