---
import BaseLayout from '../../layouts/BaseLayout.astro';
import pyqs from '../../data/previous-papers.json';

const examCategories = {
  'SSC': ['SSC CGL', 'SSC CHSL', 'SSC MTS', 'SSC CPO', 'SSC JE', 'SSC GD', 'SSC Stenographer', 'SSC Selection Post'],
  'Railway': ['RRB NTPC', 'RRB Group D', 'RRB ALP', 'RRB JE', 'RRB RPF'],
  'Banking': ['IBPS PO', 'IBPS Clerk', 'IBPS SO', 'IBPS RRB PO', 'IBPS RRB Clerk', 'SBI PO', 'SBI Clerk', 'RBI Grade B'],
  'UPSC': ['UPSC CSE', 'UPSC CAPF', 'UPSC NDA', 'UPSC CDS'],
  'State PSC': ['UPPSC PCS', 'BPSC', 'MPPSC', 'RPSC RAS'],
  'Police': ['Delhi Police Constable', 'UP Police Constable'],
  'Teaching': ['CTET', 'KVS PGT'],
  'Other': ['UGC NET', 'CSIR NET', 'JEE Main', 'CUET PG']
};

const categories = Object.keys(examCategories);
const totalExams = pyqs.length;
const totalPapers = pyqs.reduce((sum, p) => sum + p.papers.length, 0);
---

<BaseLayout
  title="Previous Year Question Papers (PYQ) 2016-2026 | Sarkari Sahayak"
  description="SSC CGL, CHSL, RRB NTPC, IBPS PO, SBI Clerk, UPSC CSE — sab exams ke Previous Year Papers with PDF download links. Topic-wise analysis aur difficulty level."
  canonical="/pyq/"
>
  <section class="section">
    <div class="container">
      <div class="section-head center-head">
        <span class="section-label">PYQ Papers 2016-2026</span>
        <h1 class="section-title">Previous Year Question Papers</h1>
        <p class="section-sub">{totalExams} exams ke {totalPapers}+ papers — official PDF links ke saath</p>
      </div>

      <div class="pyq-stats">
        <div class="pyq-stat">
          <span class="pyq-stat-num">{totalExams}</span>
          <span class="pyq-stat-label">Exams Covered</span>
        </div>
        <div class="pyq-stat">
          <span class="pyq-stat-num">{totalPapers}+</span>
          <span class="pyq-stat-label">Question Papers</span>
        </div>
        <div class="pyq-stat">
          <span class="pyq-stat-num">10</span>
          <span class="pyq-stat-label">Years (2016-2026)</span>
        </div>
        <div class="pyq-stat">
          <span class="pyq-stat-num">Free</span>
          <span class="pyq-stat-label">PDF Downloads</span>
        </div>
      </div>

      <div class="chips-row" id="pyqFilters" role="group" aria-label="PYQ category filters">
        <button type="button" class="chip active" data-filter="all">All<span class="cnt">{totalExams}</span></button>
        {categories.map(cat => (
          <button type="button" class="chip" data-filter={cat}>
            {cat}
            <span class="cnt">{pyqs.filter(p => examCategories[cat]?.includes(p.exam)).length}</span>
          </button>
        ))}
      </div>

      <div class="guide-list" style="margin-top:var(--sp-xl)" id="pyqList">
        {pyqs.map((pyq, i) => {
          const cat = Object.keys(examCategories).find(c => examCategories[c]?.includes(pyq.exam)) || 'Other';
          const latestYear = Math.max(...pyq.papers.map(p => p.year));
          const years = [...new Set(pyq.papers.map(p => p.year))].sort((a,b) => b-a);
          return (
            <div class="guide-item pyq-item" data-category={cat}>
              <span class="guide-num">{i + 1}</span>
              <div class="guide-body">
                <span class="guide-title">{pyq.exam} — Previous Year Papers</span>
                <div class="guide-tags">
                  <span class="gtag gtag-cat">{cat}</span>
                  <span class="gtag">{pyq.papers.length} Papers</span>
                  <span class="gtag gtag-time">{years[0]}-{years[years.length-1]}</span>
                  <span class="gtag">{pyq.officialSite.replace('https://', '')}</span>
                </div>
                <div class="pyq-paper-list">
                  {pyq.papers.slice(0, 6).map(paper => (
                    <a href={paper.downloadUrl} target="_blank" rel="noopener" class="pyq-paper-link">
                      <span class="pyq-year">{paper.year}</span>
                      <span class="pyq-tier">{paper.tier}</span>
                      <span class="pyq-shifts">{paper.shifts} shifts</span>
                      <span class={`pyq-diff pyq-diff-${paper.difficulty.toLowerCase().replace('-', '')}`}>{paper.difficulty}</span>
                    </a>
                  ))}
                  {pyq.papers.length > 6 && (
                    <span class="pyq-more">+{pyq.papers.length - 6} more papers</span>
                  )}
                </div>
              </div>
              <a href={pyq.officialSite} target="_blank" rel="noopener" class="guide-arrow" title="Official Site">→</a>
            </div>
          );
        })}
      </div>

      <div class="pyq-info">
        <h2>PYQ Papers Kyun Important Hai?</h2>
        <ul>
          <li><strong>Pattern Samjho:</strong> Har exam ka pattern alag hota hai. PYQ se pata chalta hai ki kya aata hai.</li>
          <li><strong>Difficulty Level:</strong> Easy, Moderate, Difficult — har shift ka analysis milta hai.</li>
          <li><strong>Topic-wise Weightage:</strong> Kaunse topics se zyada questions aate hain, woh samajh aata hai.</li>
          <li><strong>Time Management:</strong> Real exam feel ke liye practice karo with timer.</li>
          <li><strong>Confidence Badhao:</strong> Jab 5-10 saal ke papers dekhoge toh exam ka darr khatam hoga.</li>
        </ul>
      </div>

      <div class="pyq-notice">
        <strong>Note:</strong> Sab PDF links official government websites (SSC, RRB, UPSC, IBPS, SBI) ke hain. Hum koi copyrighted content host nahi karte. Sirf official sources se redirect karte hain.
      </div>
    </div>
  </section>

  <script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var filterBtns = document.querySelectorAll('#pyqFilters .chip');
    var items = document.querySelectorAll('#pyqList .guide-item');

    filterBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        filterBtns.forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        var f = btn.getAttribute('data-filter');
        items.forEach(function(item) {
          if (f === 'all' || item.getAttribute('data-category') === f) {
            item.style.display = '';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });
  });
  </script>

  <style>
    .pyq-stats {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px;
      margin-bottom: 24px;
    }
    .pyq-stat {
      text-align: center; padding: 16px 12px; border-radius: 12px;
      background: var(--card); border: 1px solid var(--hairline);
    }
    .pyq-stat-num { display: block; font-family: var(--font-display); font-size: 24px; font-weight: 800; color: var(--saffron); }
    .pyq-stat-label { font-size: 12px; color: var(--muted); }
    .pyq-paper-list { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
    .pyq-paper-link {
      display: inline-flex; align-items: center; gap: 4px;
      padding: 3px 8px; border-radius: 6px; font-size: 11px;
      background: var(--elevated); border: 1px solid var(--hairline);
      color: var(--body); text-decoration: none; transition: all .15s;
    }
    .pyq-paper-link:hover { border-color: var(--saffron); color: var(--saffron); }
    .pyq-year { font-weight: 700; color: var(--strong); }
    .pyq-tier { color: var(--muted); }
    .pyq-shifts { color: var(--muted); }
    .pyq-diff { padding: 1px 5px; border-radius: 3px; font-weight: 600; font-size: 10px; }
    .pyq-diff-easy { background: rgba(15,163,54,.12); color: #0fa336; }
    .pyq-diff-moderate { background: rgba(255,193,7,.12); color: #f59e0b; }
    .pyq-diff-difficult { background: rgba(239,68,68,.12); color: #ef4444; }
    .pyq-more { font-size: 11px; color: var(--saffron); font-weight: 600; padding: 3px 8px; }
    .pyq-info {
      margin-top: 32px; padding: 20px; border-radius: 12px;
      background: var(--card); border: 1px solid var(--hairline);
    }
    .pyq-info h2 { font-family: var(--font-display); font-size: 18px; font-weight: 700; color: var(--strong); margin-bottom: 12px; }
    .pyq-info ul { padding-left: 20px; margin: 0; }
    .pyq-info li { font-size: 14px; color: var(--body); margin-bottom: 8px; line-height: 1.5; }
    .pyq-notice {
      margin-top: 16px; padding: 12px 16px; border-radius: 8px;
      background: rgba(255,193,7,.08); border: 1px solid rgba(255,193,7,.2);
      font-size: 13px; color: var(--body);
    }
    @media (max-width: 640px) {
      .pyq-stats { grid-template-columns: repeat(2, 1fr); }
    }
  </style>
</BaseLayout>
