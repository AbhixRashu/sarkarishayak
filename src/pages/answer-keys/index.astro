---
import BaseLayout from '../../layouts/BaseLayout.astro';
import answerKeys from '../../data/answer-keys.json';
---

<BaseLayout
  title="Latest Answer Key 2026 | Objection Link | Sarkari Sahayak"
  description="2026 के सभी Latest Answer Keys — NTA UGC NET, SSC GD, RRB JE, RPSC, UPSC CMS। Provisional answer key download karein, objection link check karein।"
  canonical="/answer-keys/"
>
  <section class="section">
    <div class="container">
      <div class="section-head center-head">
        <span class="section-label">Answer Key 2026</span>
        <h1 class="section-title">Latest Answer Keys</h1>
        <p class="section-sub">Provisional answer keys &amp; objection links — deadline se pehle check karein</p>
      </div>

      <div class="guide-list" style="margin-top:var(--sp-xl)">
        {answerKeys.map((key, i) => (
          <a href={`/answer-keys/${key.slug}`} class="guide-item">
            <span class="guide-num">{i + 1}</span>
            <div class="guide-body">
              <span class="guide-title">{key.title}</span>
              <div class="guide-tags">
                <span class="gtag gtag-cat">{key.organization}</span>
                <span class="gtag gtag-time">Released: {key.releaseDate}</span>
                <span class="gtag" style="color:var(--m-red);border-color:rgba(226,39,24,.4)">Objection by: {key.objectionDeadline}</span>
              </div>
            </div>
            <span class="guide-arrow">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
