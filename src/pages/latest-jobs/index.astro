---
import BaseLayout from '../../layouts/BaseLayout.astro';
import jobs from '../../data/latest-jobs.json';

function parseDate(d: string): Date | null {
  if (!d || d.toLowerCase().includes('check official') || d.toLowerCase().includes('soon')) return null;
  const parts = d.split('/');
  if (parts.length === 3) {
    const [dd, mm, yyyy] = parts.map(Number);
    if (yyyy && mm && dd) return new Date(yyyy, mm - 1, dd);
  }
  const iso = new Date(d);
  return isNaN(iso.getTime()) ? null : iso;
}

const sortedJobs = [...jobs].sort((a, b) => {
  const da = parseDate(a.postDate);
  const db = parseDate(b.postDate);
  if (da && db) return db.getTime() - da.getTime();
  if (da) return -1;
  if (db) return 1;
  return 0;
});

const categories = [...new Set(sortedJobs.map(j => j.category))];
const categoryLabels: Record<string, string> = {
  banking: 'Banking',
  rajasthan: 'Rajasthan',
  central: 'Central Govt',
  railway: 'Railway',
  state: 'State Govt',
  defence: 'Defence',
  psu: 'PSU',
  ssc: 'SSC',
  psc: 'State PSC',
  teaching: 'Teaching',
  medical: 'Medical / Health',
  engineering: 'Engineering',
  police: 'Police / Paramilitary',
  court: 'Court / Judiciary'
};

const totalVacancies = sortedJobs.reduce((sum, j) => sum + (j.vacancies || 0), 0);
const now = new Date();
const monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const currentMonthYear = `${monthNames[now.getMonth()]} ${now.getFullYear()}`;
const openCount = sortedJobs.filter(j => {
  const d = parseDate(j.lastDate);
  return !d || d >= now;
}).length;
---

<BaseLayout
  title={`Latest Government Jobs September 2026 — ${sortedJobs.length} Open Vacancies | Sarkari Sahayak`}
  description={`September 2026 ki ${sortedJobs.length} Latest Government Jobs — SSC, Railway, Banking, UPSC, Rajasthan, Defence. Vacancy ${totalVacancies.toLocaleString('en-IN')}, last date, apply link sab ek jagah। Sarkari Naukri 2026।`}
  canonical="/latest-jobs/"
  keywords="latest government jobs 2026, sarkari naukri 2026, govt jobs september 2026, latest vacancy 2026, sarkari result, govt job apply online"
>
  <section class="section">
    <div class="container">
      <div class="section-head center-head">
        <span class="section-label">Sarkari Naukri 2026</span>
        <h1 class="section-title">Latest Government Jobs</h1>
        <p class="section-sub">Abhi {openCount} jobs open hain — apply karein before last date. Banking, Railway, Rajasthan, Central sab covered. Updated {currentMonthYear}.</p>
      </div>

      <div class="lj-freshness" style="margin-bottom:var(--sp-xl)">
        <p style="font-size:15px;line-height:1.7;color:var(--body);text-align:center;max-width:700px;margin:0 auto">
          Find the latest {sortedJobs.length} government job vacancies with {totalVacancies.toLocaleString('en-IN')}+ total posts — SSC CHSL, Railway NTPC, Delhi Police Constable, BSF Head Constable, Navy Agniveer, and more. Updated daily with verified apply links.
        </p>
      </div>

      <div class="chips-row" id="jobFilters" role="group" aria-label="Job category filters">
        <button type="button" class="chip active" data-filter="all">All<span class="cnt">{sortedJobs.length}</span></button>
        {categories.map(cat => (
          <button type="button" class="chip" data-filter={cat}>
            {categoryLabels[cat] || cat}
            <span class="cnt">{sortedJobs.filter(j => j.category === cat).length}</span>
          </button>
        ))}
      </div>

      <div class="tt-wrap" style="margin-top:var(--sp-xl)">
        <table class="tt-table" id="jobsTable">
          <thead>
            <tr>
              <th style="width:40%">Post / Recruitment</th>
              <th>Organization</th>
              <th style="text-align:center">Vacancies</th>
              <th>Last Date</th>
              <th>Posted</th>
              <th style="text-align:center">Apply</th>
            </tr>
          </thead>
          <tbody>
            {sortedJobs.map(job => (
              <tr data-category={job.category}>
                <td>
                  <a href={`/latest-jobs/${job.slug}`} style="color:var(--strong);font-weight:400">{job.title}</a>
                  <br/>
                  <span style="font-size:12px;color:var(--muted)">{job.qualify}</span>
                </td>
                <td style="white-space:nowrap">{job.organization}</td>
                <td style="text-align:center;font-family:var(--font-display);font-weight:700;color:var(--gold)">
                  {job.vacancies > 0 ? job.vacancies.toLocaleString('en-IN') : '—'}
                </td>
                <td style="white-space:nowrap;font-family:var(--font-display);font-weight:600">{job.lastDate}</td>
                <td style="white-space:nowrap;font-size:12px;color:var(--muted)">{job.postDate || '—'}</td>
                <td style="text-align:center">
                  <a href={job.applyUrl} target="_blank" rel="noopener" class="btn-ghost" style="height:36px;padding:0 14px;font-size:11px">
                    Apply ↗
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ========== RELATED PAGES ========== -->
  <section class="section" style="background:var(--soft);padding-block:var(--sp-xxl)">
    <div class="container">
      <div class="section-head center-head" style="margin-bottom:var(--sp-lg)">
        <span class="section-label">Explore More</span>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:var(--sp-md)">
        <a href="/latest-jobs/" style="display:flex;align-items:center;gap:var(--sp-sm);padding:var(--sp-md);background:var(--card);border:2px solid var(--saffron);text-decoration:none;transition:transform .2s" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform=''">
          <span style="font-size:24px">🔥</span>
          <div><span style="display:block;font-family:var(--font-display);font-weight:700;font-size:13px;letter-spacing:1px;text-transform:uppercase;color:var(--strong)">Latest Jobs</span><span style="font-size:12px;color:var(--muted)">All open vacancies</span></div>
        </a>
        <a href="/results/" style="display:flex;align-items:center;gap:var(--sp-sm);padding:var(--sp-md);background:var(--card);border:1px solid var(--hairline);text-decoration:none;transition:all .2s" onmouseover="this.style.borderColor='var(--saffron)';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='var(--hairline)';this.style.transform=''">
          <span style="font-size:24px">📊</span>
          <div><span style="display:block;font-family:var(--font-display);font-weight:700;font-size:13px;letter-spacing:1px;text-transform:uppercase;color:var(--strong)">Results</span><span style="font-size:12px;color:var(--muted)">Exam results & merit lists</span></div>
        </a>
        <a href="/qualifications/12th-pass/" style="display:flex;align-items:center;gap:var(--sp-sm);padding:var(--sp-md);background:var(--card);border:1px solid var(--hairline);text-decoration:none;transition:all .2s" onmouseover="this.style.borderColor='var(--saffron)';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='var(--hairline)';this.style.transform=''">
          <span style="font-size:24px">🎓</span>
          <div><span style="display:block;font-family:var(--font-display);font-weight:700;font-size:13px;letter-spacing:1px;text-transform:uppercase;color:var(--strong)">12th Pass Jobs</span><span style="font-size:12px;color:var(--muted)">CHSL, NDA, Navy</span></div>
        </a>
        <a href="/scholarship/" style="display:flex;align-items:center;gap:var(--sp-sm);padding:var(--sp-md);background:var(--card);border:1px solid var(--hairline);text-decoration:none;transition:all .2s" onmouseover="this.style.borderColor='var(--saffron)';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='var(--hairline)';this.style.transform=''">
          <span style="font-size:24px">🏆</span>
          <div><span style="display:block;font-family:var(--font-display);font-weight:700;font-size:13px;letter-spacing:1px;text-transform:uppercase;color:var(--strong)">Scholarships</span><span style="font-size:12px;color:var(--muted)">Central & state scholarships</span></div>
        </a>
        <a href="/tools/cutoff-tracker/" style="display:flex;align-items:center;gap:var(--sp-sm);padding:var(--sp-md);background:var(--card);border:1px solid var(--hairline);text-decoration:none;transition:all .2s" onmouseover="this.style.borderColor='var(--saffron)';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='var(--hairline)';this.style.transform=''">
          <span style="font-size:24px">📈</span>
          <div><span style="display:block;font-family:var(--font-display);font-weight:700;font-size:13px;letter-spacing:1px;text-transform:uppercase;color:var(--strong)">Cutoff Tracker</span><span style="font-size:12px;color:var(--muted)">Previous year cutoffs</span></div>
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var filterBtns = document.querySelectorAll('#jobFilters .chip');
    var rows = document.querySelectorAll('#jobsTable tbody tr');

    filterBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        filterBtns.forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        var f = btn.getAttribute('data-filter');
        rows.forEach(function(row) {
          if (f === 'all' || row.getAttribute('data-category') === f) {
            row.style.display = '';
          } else {
            row.style.display = 'none';
          }
        });
      });
    });
  });
  </script>
</BaseLayout>
