---
import BaseLayout from '../../layouts/BaseLayout.astro';
import jobs from '../../data/latest-jobs.json';

export function getStaticPaths() {
  return jobs.map(job => ({
    params: { slug: job.slug },
    props: { job },
  }));
}

const { job } = Astro.props;
const siteUrl = 'https://govtjob.salarypitcher.com';

const jobPostingSchema = {
  "@context": "https://schema.org",
  "@type": "JobPosting",
  "title": job.title,
  "description": `${job.title} — ${job.organization}. ${job.vacancies || 'Multiple'} vacancies. Last date: ${job.lastDate}. Apply online.`,
  "datePosted": job.startDate || new Date().toISOString().split('T')[0],
  "validThrough": job.lastDate ? job.lastDate.split('/').reverse().join('-') : undefined,
  "employmentType": "FULL_TIME",
  "hiringOrganization": {
    "@type": "Organization",
    "name": job.organization,
    "sameAs": job.applyUrl || siteUrl
  },
  "jobLocation": {
    "@type": "Place",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "IN"
    }
  },
  "baseSalary": {
    "@type": "MonetaryAmount",
    "currency": "INR",
    "value": {
      "@type": "QuantitativeValue",
      "minValue": job.feeGeneral ? parseInt(job.feeGeneral.replace(/[^\d]/g, '')) : undefined,
      "unitText": "APPLICATION FEE"
    }
  },
  "identifier": {
    "@type": "PropertyValue",
    "name": job.organization,
    "value": job.advNumber || job.slug
  },
  "applicationContact": {
    "@type": "Organization",
    "name": job.organization
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl + "/" },
    { "@type": "ListItem", "position": 2, "name": "Latest Jobs", "item": siteUrl + "/latest-jobs/" },
    { "@type": "ListItem", "position": 3, "name": job.shortTitle || job.title }
  ]
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": `${job.shortTitle || job.title} — Online Apply Kaise Karein`,
  "description": `Step-by-step guide for ${job.shortTitle || job.title} online application.`,
  "step": (job.howToApply || [
    'Visit the official website of the recruiting organization.',
    'Find the relevant recruitment notification.',
    'Register and fill the online application form.',
    'Upload required documents (photograph, signature, certificates).',
    'Pay the application fee online.',
    'Submit the form and save/print the confirmation.',
  ]).map((step, i) => ({
    "@type": "HowToStep",
    "position": i + 1,
    "text": step
  }))
};

const eventSchema = job.examDate && job.examDate !== 'To be announced' ? {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": `${job.shortTitle || job.title} — ${job.examDate}`,
  "startDate": job.examDate,
  "organizer": {
    "@type": "Organization",
    "name": job.organization
  },
  "location": {
    "@type": "Place",
    "name": "India",
    "address": { "@type": "PostalAddress", "addressCountry": "IN" }
  },
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode"
} : null;

const lastUpdated = new Date().toLocaleDateString('hi-IN', { year: 'numeric', month: 'long', day: 'numeric' });

const d = {
  advNo: job.advNumber || 'Check Official Notification',
  postDate: job.postDate || job.startDate,
  applyStart: job.startDate || job.lastDate,
  lastDateApply: job.lastDate,
  feeLastDate: job.feePaymentLastDate || job.lastDate,
  correctionDate: job.correctionDate || 'N/A',
  examDate: job.examDate || 'To be announced',
  resultDate: job.resultDate || 'To be announced',
  feeGeneral: job.feeGeneral || '₹800–₹1000',
  feeSCST: job.feeSC_ST || '₹300–₹400',
  feePH: job.feePH || '₹0 (Exempted)',
  ageMin: job.ageMin || 18,
  ageMax: job.ageMax || 40,
  ageRelaxation: 'SC/ST: 5 yrs, OBC: 3 yrs, PH: 10 yrs, Ex-Servicemen: as per Govt rules.',
  posts: job.vacancyDetails || [{ postName: job.title.replace(/ Online Form.*/, '').replace(/ —.*/, ''), posts: job.vacancies || 'TBA' }],
  qualifications: job.eligibility || [{ postName: job.qualify || 'Post Name', details: job.qualify ? `${job.qualify} from a recognized University/Institution.` : 'Check Official Notification' }],
  howToApply: job.howToApply || [
    'Visit the official website of the recruiting organization.',
    'Find the relevant recruitment notification.',
    'Register and fill the online application form.',
    'Upload required documents (photograph, signature, certificates).',
    'Pay the application fee online.',
    'Submit the form and save/print the confirmation.',
  ],
  selectionProcess: job.selectionProcess || ['Written Examination', 'Skill/Physical Test (if applicable)', 'Document Verification', 'Final Merit List'],
  links: job.importantLinks || [
    { label: 'Apply Online', url: job.applyUrl || '#' },
    { label: 'Download Notification', url: '#' },
    { label: 'Official Website', url: '#' },
  ],
  examPattern: job.examPattern || [
    { stage: 'Prelims', subjects: 'Reasoning, English, Quantitative Aptitude, General Awareness', questions: 200, maxMarks: 200, duration: '120 minutes' },
    { stage: 'Mains', subjects: 'Economic & Social Issues, Agriculture & Rural Development, English, Computer Knowledge', questions: 200, maxMarks: 200, duration: '120 minutes' }
  ],
  salaryDetails: job.salaryDetails || {
    payScale: job.salary || 'As per 7th Pay Commission Matrix',
    grossSalary: '₹60,000 to ₹70,000 (including allowances)',
    allowances: 'Dearness Allowance, HRA, Special Allowance, Medical Benefits'
  },
  faq: job.faq || [
    { question: `${job.shortTitle || job.title} ka exam kab hoga?`, answer: 'Exam date abhi officially announce nahi hui hai.' },
    { question: `${job.shortTitle || job.title} mein kitni vacancy hai?`, answer: `Is recruitment mein total ${job.vacancies ? job.vacancies.toLocaleString('en-IN') : 'TBA'} posts hain.` },
    { question: `${job.shortTitle || job.title} ke liye online apply kaise karein?`, answer: 'Official website par jaake registration karein, form fill karein, documents upload karein aur fee pay karein.' },
    { question: `${job.shortTitle || job.title} ki eligibility kya hai?`, answer: `Educational qualification: ${job.qualify || 'Check official notification'}. Age limit: ${job.ageMin || 18}-${job.ageMax || 40} years.` },
    { question: `${job.shortTitle || job.title} ki last date kya hai?`, answer: `Online apply ki last date ${job.lastDate} hai.` }
  ],
  socialLinks: job.socialLinks || { telegram: '#', whatsapp: '#', facebook: '#' },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": d.faq.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};
---

<BaseLayout 
  title={`${job.title} | Sarkari Sahayak 2026`} 
  description={`${job.title} — ${job.organization}. Vacancies: ${job.vacancies || 'TBA'}. Last Date: ${job.lastDate}. Apply online now.`} 
  canonical={`/latest-jobs/${job.slug}/`}
  ogType="article"
  keywords={`${job.title}, ${job.organization} recruitment 2026, ${job.category || 'sarkari naukri'} vacancy, apply online, sarkari job 2026, latest government jobs`}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jobPostingSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(howToSchema)} />
    {eventSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(eventSchema)} />}
  </Fragment>
  <main class="job-detail-page">

    <!-- breadcrumb -->
    <div class="jd-breadcrumb">
      <div class="container">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/latest-jobs/">Latest Jobs</a>
        <span>/</span>
        <span class="current">{job.shortTitle || job.title}</span>
      </div>
    </div>

    <div class="container jd-wrap">

      <!-- hero header -->
      <div class="jd-hero">
        <div class="jd-hero-badge">{job.category?.toUpperCase() || 'GOVT JOB'}</div>
        <h1 class="jd-hero-title">{job.title}</h1>
        <div class="jd-hero-org">{job.organization}</div>
        {d.advNo && <div class="jd-hero-adv">Adv. No: {d.advNo}</div>}
        <div class="jd-hero-meta">
          <span class="jd-meta-chip">👥 {job.vacancies ? job.vacancies.toLocaleString('en-IN') : 'TBA'} Posts</span>
          <span class="jd-meta-chip deadline">⏰ Last Date: {job.lastDate}</span>
          <span class="jd-meta-chip">📋 {job.qualify || 'Graduate'}</span>
        </div>
      </div>

      <!-- two column layout -->
      <div class="jd-grid">

        <!-- main content -->
        <div class="jd-main">

          <!-- Important Dates -->
          <section class="jd-card">
            <h2 class="jd-card-head"><span class="jd-head-icon">📅</span> Important Dates</h2>
            <div class="jd-dates-grid">
              <div class="jd-date-item">
                <div class="jd-date-label">Application Start</div>
                <div class="jd-date-val">{d.applyStart}</div>
              </div>
              <div class="jd-date-item highlight">
                <div class="jd-date-label">Last Date to Apply</div>
                <div class="jd-date-val">{d.lastDateApply}</div>
              </div>
              <div class="jd-date-item">
                <div class="jd-date-label">Fee Payment Last Date</div>
                <div class="jd-date-val">{d.feeLastDate}</div>
              </div>
              <div class="jd-date-item">
                <div class="jd-date-label">Correction Window</div>
                <div class="jd-date-val">{d.correctionDate}</div>
              </div>
              <div class="jd-date-item">
                <div class="jd-date-label">Exam Date</div>
                <div class="jd-date-val">{d.examDate}</div>
              </div>
              <div class="jd-date-item">
                <div class="jd-date-label">Result Date</div>
                <div class="jd-date-val">{d.resultDate}</div>
              </div>
            </div>
          </section>

          <!-- Vacancy Details -->
          <section class="jd-card">
            <h2 class="jd-card-head"><span class="jd-head-icon">👥</span> Vacancy Details <span class="jd-head-total">Total: {job.vacancies ? job.vacancies.toLocaleString('en-IN') : 'TBA'} Posts</span></h2>
            <div class="jd-table-wrap">
              <table class="jd-table">
                <thead>
                  <tr>
                    <th>Post Name</th>
                    <th class="center">No. of Posts</th>
                  </tr>
                </thead>
                <tbody>
                  {d.posts.map((p) => (
                    <tr>
                      <td class="bold">{p.postName}</td>
                      <td class="center gold">{p.posts}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>

          <!-- Educational Qualification -->
          <section class="jd-card">
            <h2 class="jd-card-head"><span class="jd-head-icon">🎓</span> Educational Qualification</h2>
            <div class="jd-table-wrap">
              <table class="jd-table">
                <thead>
                  <tr>
                    <th>Post Name</th>
                    <th>Eligibility</th>
                  </tr>
                </thead>
                <tbody>
                  {d.qualifications.map((q) => (
                    <tr>
                      <td class="bold">{q.postName}</td>
                      <td>{q.details}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>

          <!-- Age Limit -->
          <section class="jd-card">
            <h2 class="jd-card-head"><span class="jd-head-icon">🎂</span> Age Limit</h2>
            <div class="jd-age-row">
              <div class="jd-age-box">
                <div class="jd-age-label">Minimum Age</div>
                <div class="jd-age-num">{d.ageMin} Years</div>
              </div>
              <div class="jd-age-box">
                <div class="jd-age-label">Maximum Age</div>
                <div class="jd-age-num">{d.ageMax} Years</div>
              </div>
            </div>
            <p class="jd-age-note"><strong>Age Relaxation:</strong> {d.ageRelaxation}</p>
          </section>

          <!-- How To Apply -->
          <section class="jd-card">
            <h2 class="jd-card-head"><span class="jd-head-icon">📝</span> How To Apply</h2>
            <ol class="jd-steps">
              {d.howToApply.map((step, i) => (
                <li>
                  <span class="jd-step-num">{i + 1}</span>
                  <span class="jd-step-text">{step}</span>
                </li>
              ))}
            </ol>
          </section>

          <!-- Mode of Selection -->
          <section class="jd-card">
            <h2 class="jd-card-head"><span class="jd-head-icon">✅</span> Mode of Selection</h2>
            <ul class="jd-selection">
              {d.selectionProcess.map((step, i) => (
                <li>
                  <span class="jd-sel-num">{i + 1}</span>
                  <span>{step}</span>
                </li>
              ))}
            </ul>
          </section>

          <!-- Exam Pattern -->
          <section class="jd-card">
            <h2 class="jd-card-head"><span class="jd-head-icon">📝</span> Exam Pattern</h2>
            <div class="jd-table-wrap">
              <table class="jd-table">
                <thead>
                  <tr>
                    <th>Stage</th>
                    <th>Subjects</th>
                    <th class="center">Questions</th>
                    <th class="center">Max Marks</th>
                    <th>Duration</th>
                  </tr>
                </thead>
                <tbody>
                  {d.examPattern.map((ep) => (
                    <tr>
                      <td class="bold">{ep.stage}</td>
                      <td>{ep.subjects}</td>
                      <td class="center">{ep.questions}</td>
                      <td class="center gold">{ep.maxMarks}</td>
                      <td>{ep.duration}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>

          <!-- Salary Details -->
          <section class="jd-card">
            <h2 class="jd-card-head"><span class="jd-head-icon">💰</span> Salary & Pay Scale</h2>
            <div class="jd-salary-wrap">
              <div class="jd-salary-row">
                <div class="jd-salary-label">Pay Scale</div>
                <div class="jd-salary-val">{d.salaryDetails.payScale}</div>
              </div>
              <div class="jd-salary-row">
                <div class="jd-salary-label">Approximate Gross Salary (Monthly)</div>
                <div class="jd-salary-val gold">{d.salaryDetails.grossSalary}</div>
              </div>
              <div class="jd-salary-row">
                <div class="jd-salary-label">Additional Allowances</div>
                <div class="jd-salary-val">{d.salaryDetails.allowances}</div>
              </div>
            </div>
          </section>

          <!-- FAQ -->
          <section class="jd-card">
            <h2 class="jd-card-head"><span class="jd-head-icon">❓</span> Frequently Asked Questions</h2>
            <div class="jd-faq-wrap">
              {d.faq.map((f, i) => (
                <details class="jd-faq-item" {...(i === 0 ? { open: true } : {})}>
                  <summary class="jd-faq-q">{f.question}</summary>
                  <div class="jd-faq-a">{f.answer}</div>
                </details>
              ))}
            </div>
          </section>

        </div>

        <!-- sidebar -->
        <aside class="jd-side">

          <!-- Application Fee -->
          <div class="jd-card jd-side-card">
            <h2 class="jd-card-head"><span class="jd-head-icon">💰</span> Application Fee</h2>
            <div class="jd-fee-list">
              <div class="jd-fee-item">
                <span class="jd-fee-cat">General / OBC / EWS</span>
                <span class="jd-fee-amt">{d.feeGeneral}</span>
              </div>
              <div class="jd-fee-item">
                <span class="jd-fee-cat">SC / ST</span>
                <span class="jd-fee-amt">{d.feeSCST}</span>
              </div>
              <div class="jd-fee-item">
                <span class="jd-fee-cat">PH (Divyang)</span>
                <span class="jd-fee-amt">{d.feePH}</span>
              </div>
            </div>
          </div>

          <!-- Important Links -->
          <div class="jd-card jd-side-card jd-links-card">
            <h2 class="jd-card-head"><span class="jd-head-icon">🔗</span> Important Links</h2>
            <div class="jd-links-list">
              {d.links.map(link => (
                <a href={link.url} target="_blank" rel="noopener" class="jd-link-item">
                  <span class="jd-link-label">{link.label}</span>
                  <span class="jd-link-arrow">→</span>
                </a>
              ))}
            </div>
          </div>

          <!-- Follow Us -->
          <div class="jd-card jd-side-card jd-social-card">
            <h2 class="jd-card-head"><span class="jd-head-icon">📱</span> Follow Us</h2>
            <div class="jd-social-list">
              {d.socialLinks.telegram && d.socialLinks.telegram !== '#' && (
                <a href={d.socialLinks.telegram} target="_blank" rel="noopener" class="jd-social-item telegram">
                  <span class="jd-social-icon">✈️</span>
                  <span>Telegram</span>
                </a>
              )}
              {d.socialLinks.whatsapp && d.socialLinks.whatsapp !== '#' && (
                <a href={d.socialLinks.whatsapp} target="_blank" rel="noopener" class="jd-social-item whatsapp">
                  <span class="jd-social-icon">💬</span>
                  <span>WhatsApp</span>
                </a>
              )}
              {d.socialLinks.facebook && d.socialLinks.facebook !== '#' && (
                <a href={d.socialLinks.facebook} target="_blank" rel="noopener" class="jd-social-item facebook">
                  <span class="jd-social-icon">📘</span>
                  <span>Facebook</span>
                </a>
              )}
            </div>
          </div>

          <!-- Quick Actions -->
          <div class="jd-card jd-side-card jd-quick-card">
            <h3 class="jd-quick-title">Quick Actions</h3>
            <a href={job.applyUrl || '#'} target="_blank" rel="noopener" class="jd-apply-btn">
              Apply Online Now →
            </a>
            <a href="/latest-jobs/" class="jd-more-jobs-btn">
              View More Jobs →
            </a>
          </div>

          <!-- Useful Tools -->
          <div class="jd-card jd-side-card">
            <h2 class="jd-card-head"><span class="jd-head-icon">🛠️</span> Useful Tools</h2>
            <div class="jd-tools-list">
              <a href="/tools/age-calculator/" class="jd-tool-item">
                <span class="jd-tool-icon">🎂</span>
                <div class="jd-tool-info">
                  <span class="jd-tool-name">Age Calculator</span>
                  <span class="jd-tool-desc">Check your eligibility</span>
                </div>
                <span class="jd-tool-arrow">→</span>
              </a>
              <a href="/tools/salary-calculator/" class="jd-tool-item">
                <span class="jd-tool-icon">💰</span>
                <div class="jd-tool-info">
                  <span class="jd-tool-name">Salary Calculator</span>
                  <span class="jd-tool-desc">7th CPC in-hand salary</span>
                </div>
                <span class="jd-tool-arrow">→</span>
              </a>
              <a href="/tools/eligibility-checker/" class="jd-tool-item">
                <span class="jd-tool-icon">🔍</span>
                <div class="jd-tool-info">
                  <span class="jd-tool-name">Eligibility Checker</span>
                  <span class="jd-tool-desc">Find matching govt jobs</span>
                </div>
                <span class="jd-tool-arrow">→</span>
              </a>
              <a href="/tools/cutoff-tracker/" class="jd-tool-item">
                <span class="jd-tool-icon">📊</span>
                <div class="jd-tool-info">
                  <span class="jd-tool-name">Cut-off Tracker</span>
                  <span class="jd-tool-desc">Previous year trends</span>
                </div>
                <span class="jd-tool-arrow">→</span>
              </a>
            </div>
          </div>

        </aside>

      </div>

      <!-- disclaimer -->
      <div class="jd-disclaimer">
        <p><strong>Disclaimer:</strong> यह जानकारी आधिकारिक अधिसूचनाओं से ली गई है। सभी विवरणों की पुष्टि आधिकारिक वेबसाइट से करें। Sarkari Sahayak इस जानकारी की सटीकता की गारंटी नहीं देता।</p>
        <p style="margin-top:8px;font-size:13px;color:var(--muted)">🕐 Last Updated: {lastUpdated}</p>
      </div>

      <!-- Internal Links Section -->
      <div class="jd-related-links">
        <h3 class="jd-related-title">सम्बंधित पेज</h3>
        <div class="jd-related-grid">
          <a href={`/syllabus/${job.slug.replace(/-20\d{2}$/, '')}/`} class="jd-related-item">
            <span class="jd-related-icon">📚</span>
            <span>{job.shortTitle || job.title} Syllabus</span>
          </a>
          <a href="/cutoffs/" class="jd-related-item">
            <span class="jd-related-icon">📊</span>
            <span>Cut-off Marks</span>
          </a>
          <a href="/admit-cards/" class="jd-related-item">
            <span class="jd-related-icon">🎫</span>
            <span>Admit Card</span>
          </a>
          <a href="/results/" class="jd-related-item">
            <span class="jd-related-icon">✅</span>
            <span>Results</span>
          </a>
          <a href="/latest-jobs/" class="jd-related-item">
            <span class="jd-related-icon">💼</span>
            <span>More Jobs</span>
          </a>
          <a href="/exam-calendar/" class="jd-related-item">
            <span class="jd-related-icon">📅</span>
            <span>Exam Calendar</span>
          </a>
        </div>
      </div>

    </div>
  </main>

  <style>
    .job-detail-page {
      padding-top: 80px;
    }

    /* breadcrumb */
    .jd-breadcrumb {
      padding: 16px 0;
      font-size: 14px;
      color: var(--muted);
    }
    .jd-breadcrumb a {
      color: var(--saffron);
      text-decoration: none;
      transition: color .2s;
    }
    .jd-breadcrumb a:hover { color: var(--accent); }
    .jd-breadcrumb span { margin: 0 8px; }
    .jd-breadcrumb .current { color: var(--strong); font-weight: 500; }

    .jd-wrap {
      max-width: 1100px;
      margin: 0 auto;
    }

    /* hero */
    .jd-hero {
      background: linear-gradient(135deg, var(--navy) 0%, rgba(28,105,212,.15) 100%);
      border: 1px solid var(--hairline);
      border-radius: 16px;
      padding: 32px;
      margin-bottom: 32px;
    }
    .jd-hero-badge {
      display: inline-block;
      padding: 4px 12px;
      background: var(--saffron);
      color: #000;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.5px;
      border-radius: 4px;
      margin-bottom: 16px;
    }
    .jd-hero-title {
      font-size: 28px;
      font-weight: 800;
      line-height: 1.2;
      color: var(--white);
      margin-bottom: 8px;
    }
    .jd-hero-org {
      font-size: 16px;
      color: var(--saffron);
      font-weight: 600;
      margin-bottom: 4px;
    }
    .jd-hero-adv {
      font-size: 14px;
