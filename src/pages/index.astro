---
import BaseLayout from '../layouts/BaseLayout.astro';
import latestJobs from '../data/latest-jobs.json';
import answerKeys from '../data/answer-keys.json';
import syllabusData from '../data/syllabus.json';

const topJobs = latestJobs.slice(0, 9).map(job => {
  const daysLeft = Math.ceil((new Date(job.lastDate).getTime() - Date.now()) / 86400000);
  const urgency = daysLeft <= 3 ? 'urgent' : daysLeft <= 7 ? 'soon' : 'open';
  const deadlineWidth = Math.max(5, 100 - (daysLeft / 30 * 100));
  return { ...job, daysLeft, urgency, deadlineWidth };
});
const topAnswerKeys = answerKeys.slice(0, 8);

const topExams = [
  { name: 'SSC CGL 2026', stage: 'Prelims', date: '2026-10-01', color: '#FF6B35', vacancies: '18000+' },
  { name: 'UPSC CSE 2026', stage: 'Prelims', date: '2026-05-24', color: '#0fa336', vacancies: '1000+' },
  { name: 'IBPS PO XVII', stage: 'Prelims', date: '2026-10-15', color: '#FFC107', vacancies: '5000+' },
];
---

<BaseLayout title="Sarkari Sahayak — Govt Jobs, Result, Admit Card 2026 | सरकारी नौकरी" description="India's #1 Hindi Govt Job Portal. Latest Sarkari Naukri 2026 — Banking, Railway, SSC, UPSC, Rajasthan। Result, Admit Card, Syllabus sab ek jagah।">



  <!-- ========== HERO ========== -->
  <section class="hero">
    <div class="container hero-inner">
      <!-- Social Proof Counter -->
      <div class="social-proof" id="socialProof">
        <span class="sp-dot"></span>
        <span id="socialProofText">Loading...</span>
      </div>

      <p class="hero-badge">🏆 India's #1 Hindi Govt Job Portal</p>
      <h1 class="hero-title">
        <span class="ht-line">SARKARI NAUKRI</span>
        <span class="ht-line"><span class="accent-word">ABHI</span> APPLY KAREIN</span>
      </h1>
      <p class="hero-sub">Latest Govt Jobs 2026 — Banking, Railway, SSC, UPSC, Rajasthan. Result, Admit Card, Syllabus sab milega।</p>

      <!-- Countdown Timer -->
      <div class="countdown-row">
        {topExams.map(exam => (
          <div class="countdown-card" style={`--cd-color: ${exam.color}`} data-date={exam.date}>
            <div class="cd-header">
              <span class="cd-name">{exam.name}</span>
              <span class="cd-stage">{exam.stage}</span>
            </div>
            <div class="cd-timer">
              <div class="cd-unit"><span class="cd-num" data-unit="days">--</span><span class="cd-label">Din</span></div>
              <div class="cd-sep">:</div>
              <div class="cd-unit"><span class="cd-num" data-unit="hours">--</span><span class="cd-label">Ghante</span></div>
              <div class="cd-sep">:</div>
              <div class="cd-unit"><span class="cd-num" data-unit="mins">--</span><span class="cd-label">Min</span></div>
              <div class="cd-sep">:</div>
              <div class="cd-unit"><span class="cd-num" data-unit="secs">--</span><span class="cd-label">Sec</span></div>
            </div>
            <div class="cd-vac">{exam.vacancies} Posts</div>
            <div class="cd-progress"><div class="cd-progress-fill" data-progress></div></div>
          </div>
        ))}
      </div>

      <div class="search-wrap">
        <button class="search-bar home-hero-search" data-search-trigger type="button">
          <span class="home-hero-search-ph">Job ya Exam search karein... jaise "SBI Clerk", "RRB NTPC"</span>
          <span class="search-btn"><span class="sb-txt">Search</span>🔍</span>
        </button>
      </div>

      <div class="home-hero-pills">
        <a href="/latest-jobs/?cat=banking" class="home-hpill">🏦 Banking</a>
        <a href="/latest-jobs/?cat=railway" class="home-hpill">🚂 Railway</a>
        <a href="/latest-jobs/?cat=central" class="home-hpill">🏛️ SSC/UPSC</a>
        <a href="/latest-jobs/?cat=rajasthan" class="home-hpill">🏔️ Rajasthan</a>
        <a href="/latest-jobs/?cat=state" class="home-hpill">📍 State</a>
        <a href="/latest-jobs/?cat=defence" class="home-hpill">⚔️ Defence</a>
      </div>
    </div>
  </section>

  <!-- ========== EXPLORE BY CATEGORY ========== -->
  <section class="home-sec home-sec-alt" id="explore">
    <div class="container">
      <div class="home-sec-head">
        <h2 class="home-sec-title">📂 Explore by Category</h2>
      </div>
      <div class="home-explore-grid">
        <a href="/exam-calendar/" class="home-explore-card">
          <span class="home-exp-icon">📅</span>
          <h3 class="home-exp-title">Exam Calendar 2026</h3>
          <p class="home-exp-desc">Upcoming exams ke dates dekho</p>
        </a>
        <a href="/employment-news/" class="home-explore-card">
          <span class="home-exp-icon">📰</span>
          <h3 class="home-exp-title">Employment News</h3>
          <p class="home-exp-desc">Weekly govt job notifications</p>
        </a>
        <a href="/states/uttar-pradesh/" class="home-explore-card">
          <span class="home-exp-icon">📍</span>
          <h3 class="home-exp-title">UP Jobs</h3>
          <p class="home-exp-desc">UPSSSC, UPPSC, UP Police</p>
        </a>
        <a href="/states/bihar/" class="home-explore-card">
          <span class="home-exp-icon">📍</span>
          <h3 class="home-exp-title">Bihar Jobs</h3>
          <p class="home-exp-desc">BPSC, Bihar Police, BSSC</p>
        </a>
        <a href="/states/rajasthan/" class="home-explore-card">
          <span class="home-exp-icon">📍</span>
          <h3 class="home-exp-title">Rajasthan Jobs</h3>
          <p class="home-exp-desc">RPSC, RSSB, REET</p>
        </a>
        <a href="/states/madhya-pradesh/" class="home-explore-card">
          <span class="home-exp-icon">📍</span>
          <h3 class="home-exp-title">MP Jobs</h3>
          <p class="home-exp-desc">MPSC, MP Police, MPPSC</p>
        </a>
        <a href="/qualifications/10th-pass/" class="home-explore-card">
          <span class="home-exp-icon">🎓</span>
          <h3 class="home-exp-title">10th Pass Jobs</h3>
          <p class="home-exp-desc">Constable, Army, Railway</p>
        </a>
        <a href="/qualifications/12th-pass/" class="home-explore-card">
          <span class="home-exp-icon">🎓</span>
          <h3 class="home-exp-title">12th Pass Jobs</h3>
          <p class="home-exp-desc">CHSL, NDA, Navy</p>
        </a>
        <a href="/qualifications/graduate/" class="home-explore-card">
          <span class="home-exp-icon">🎓</span>
          <h3 class="home-exp-title">Graduate Jobs</h3>
          <p class="home-exp-desc">CGL, IBPS, UPSC</p>
        </a>
        <a href="/qualifications/post-graduate/" class="home-explore-card">
          <span class="home-exp-icon">🎓</span>
          <h3 class="home-exp-title">PG Jobs</h3>
          <p class="home-exp-desc">UGC NET, Professor, Research</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ========== TOOLS — PROMINENT TOP ========== -->
  <section class="home-tools-wrap">
    <div class="container">
      <div class="home-sec-head">
        <h2 class="home-sec-title">🛠️ Free Tools</h2>
        <a href="/tools/" class="home-sec-more">All Tools →</a>
      </div>
      <div class="home-tools-grid">
        <a href="/tools/age-calculator/" class="home-tool-card">
          <span class="tc-icon">🎂</span>
          <div class="tc-body">
            <h3 class="tc-title">Age Calculator</h3>
            <p class="tc-desc">Exam cutoff date se exact age + eligibility check</p>
          </div>
          <span class="tc-arrow">→</span>
        </a>
        <a href="/tools/salary-calculator/" class="home-tool-card">
          <span class="tc-icon">💰</span>
          <div class="tc-body">
            <h3 class="tc-title">Salary Calculator</h3>
            <p class="tc-desc">7th CPC in-hand salary — Basic, DA, HRA, NPS</p>
          </div>
          <span class="tc-arrow">→</span>
        </a>
        <a href="/tools/eligibility-checker/" class="home-tool-card">
          <span class="tc-icon">🔍</span>
          <div class="tc-body">
            <h3 class="tc-title">Eligibility Checker</h3>
            <p class="tc-desc">Age, education daalo → matching jobs dikhao</p>
          </div>
          <span class="tc-arrow">→</span>
        </a>
        <a href="/tools/cutoff-tracker/" class="home-tool-card">
          <span class="tc-icon">📊</span>
          <div class="tc-body">
            <h3 class="tc-title">Cut-off Tracker</h3>
            <p class="tc-desc">Previous year cutoff trends + PYQ papers</p>
          </div>
          <span class="tc-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ========== SERVICES QUICK LINKS ========== -->
  <section class="home-quickbar">
    <div class="container">
      <div class="home-qb-links">
        <a href="/service/aadhaar/" class="home-qb-link">🪪 Aadhaar</a>
        <a href="/service/pan/" class="home-qb-link">💳 PAN Card</a>
        <a href="/service/passport/" class="home-qb-link">🛂 Passport</a>
        <a href="/service/driving-license/" class="home-qb-link">🚗 DL</a>
        <a href="/service/voter-id/" class="home-qb-link">🗳️ Voter ID</a>
        <a href="/service/ration-card/" class="home-qb-link">🍚 Ration</a>
        <a href="/national-services/" class="home-qb-link qb-more">All Services →</a>
      </div>
    </div>
  </section>

  <!-- ========== CURRENT AFFAIRS + PYQ BUTTONS ========== -->
  <section class="home-highlight-bar">
    <div class="container">
      <a href="/current-affairs/" class="home-hl-card home-hl-ca">
        <span class="home-hl-icon">📰</span>
        <div class="home-hl-body">
          <h3>Daily Current Affairs</h3>
          <p>660+ exam-relevant questions — Quiz mode ke saath</p>
        </div>
        <span class="home-hl-badge">NEW</span>
        <span class="home-hl-arrow">→</span>
      </a>
      <a href="/pyq/" class="home-hl-card home-hl-pyq">
        <span class="home-hl-icon">📝</span>
        <div class="home-hl-body">
          <h3>Previous Year Papers</h3>
          <p>77 exams ke papers — PDF download + difficulty analysis</p>
        </div>
        <span class="home-hl-arrow">→</span>
      </a>
    </div>
  </section>

  <!-- ========== LATEST JOBS ========== -->
  <section class="home-sec" id="jobs">
    <div class="container">
      <div class="home-sec-head">
        <h2 class="home-sec-title">🔥 Latest Jobs</h2>
        <a href="/latest-jobs/" class="home-sec-more">View All Jobs →</a>
      </div>
      <div class="home-jobs-grid">
        {topJobs.map(job => (
          <a href={`/latest-jobs/${job.slug}/`} class={`home-job-card ${job.urgency === 'urgent' ? 'job-urgent' : ''}`}>
            <div class="jc-top">
              <span class={`jc-cat jc-cat-${job.category}`}>{job.category}</span>
              <div class="jc-badges">
                {job.urgency === 'urgent' && <span class="jc-badge jc-badge-urgent">⚠️ {job.daysLeft} din baaki</span>}
                {job.urgency === 'soon' && <span class="jc-badge jc-badge-soon">⏰ {job.daysLeft} din</span>}
                {job.urgency === 'open' && <span class="jc-badge jc-badge-open">✅ Open</span>}
              </div>
            </div>
            <h3 class="jc-title">{job.shortTitle || job.title}</h3>
            <p class="jc-org">{job.organization}</p>
            <div class="jc-meta-row">
              <span class="jc-vac"><strong>{job.vacancies?.toLocaleString('en-IN')}</strong> Vacancies</span>
              {job.payScale && <span class="jc-salary">₹{job.payScale}</span>}
            </div>
            <div class="jc-info">
              <span>Age: {job.ageMin}–{job.ageMax}</span>
              <span>Fee: {job.feeGeneral}</span>
            </div>
            <div class="jc-footer">
              <div class="jc-deadline-bar">
                <div class={`jc-deadline-fill jc-fill-${job.urgency}`} style={`width: ${job.deadlineWidth}%`}></div>
              </div>
              <div class="jc-deadline-text">⏰ Last Date: {job.lastDate}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== TRENDING / AAJ KYA VIRAL HAI ========== -->
  <section class="home-sec home-sec-alt" id="trending">
    <div class="container">
      <div class="home-sec-head">
        <h2 class="home-sec-title">📈 Aaj Kya Viral Hai</h2>
        <span class="home-sec-more">Live Views</span>
      </div>
      <div class="home-trending-grid" id="trendingGrid">
        <div class="trending-skeleton">Loading trending jobs...</div>
      </div>
    </div>
  </section>

  <!-- ========== ANSWER KEYS ========== -->
  <section class="home-sec home-sec-alt" id="answer-keys">
    <div class="container">
      <div class="home-sec-head">
        <h2 class="home-sec-title">🔑 Answer Keys</h2>
        <a href="/answer-keys/" class="home-sec-more">View All →</a>
      </div>
      <div class="home-list">
        {topAnswerKeys.map((key, i) => (
          <a href={`/answer-keys/${key.slug}/`} class="home-lc-item">
            <span class="home-lc-num">{i + 1}</span>
            <div class="home-lc-body">
              <span class="home-lc-title">{key.title}</span>
              <span class="home-lc-meta">{key.organization} · Released: {key.releaseDate}</span>
            </div>
            <span class="home-lc-status home-lc-red">Objection by {key.objectionDeadline}</span>
            <span class="home-lc-arrow">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== SYLLABUS ========== -->
  <section class="home-sec" id="syllabus">
    <div class="container">
      <div class="home-sec-head">
        <h2 class="home-sec-title">📚 Syllabus & Exam Pattern</h2>
        <a href="/syllabus/" class="home-sec-more">View All →</a>
      </div>
      <div class="home-syll-grid">
        {syllabusData.map(exam => (
          <a href={`/syllabus/${exam.id}/`} class="home-syll-card">
            <div class="sc-top">
              <h3 class="sc-title">{exam.exam}</h3>
              <span class="sc-level">{exam.level}</span>
            </div>
            <div class="sc-meta">{exam.tiers} Tiers · {exam.totalMarks} Marks · {exam.duration}</div>
            <div class="sc-tags">
              {exam.subjects.slice(0, 3).map(s => <span class="sc-tag">{s.name}</span>)}
              {exam.subjects.length > 3 && <span class="sc-tag">+{exam.subjects.length - 3}</span>}
            </div>
            <div class="sc-warn">⚠️ {exam.negativeMarking}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== PREVIOUS YEAR PAPERS ========== -->
  <section class="home-sec home-sec-alt" id="pyq">
    <div class="container">
      <div class="home-sec-head">
        <h2 class="home-sec-title">📝 Previous Year Papers</h2>
        <a href="/pyq/" class="home-sec-more">View All Papers →</a>
      </div>
      <a href="/pyq/" class="home-pyq-cta">
        <span class="home-pyq-cta-icon">📝</span>
        <div class="home-pyq-cta-body">
          <h3>77 Exams ke Previous Year Papers</h3>
          <p>SSC CGL, RRB NTPC, IBPS PO, UPSC CSE — sabke papers ek jagah. PDF download, difficulty analysis, topic-wise pattern.</p>
        </div>
        <span class="home-pyq-cta-arrow">→</span>
      </a>
    </div>
  </section>

  <!-- ========== HOW IT WORKS ========== -->
  <section class="home-sec home-how-sec">
    <div class="container">
      <div class="home-sec-head center">
        <h2 class="home-sec-title">Kaise Kaam Karta Hai?</h2>
      </div>
      <div class="home-how-grid">
        <div class="home-how-step">
          <div class="home-how-num">1</div>
          <h3>Job Dhundho</h3>
          <p>Filter lagao ya search karo — apni category, state, qualification ke hisaab se</p>
        </div>
        <div class="home-how-step">
          <div class="home-how-num">2</div>
          <h3>Details Padho</h3>
          <p>Vacancy, eligibility, syllabus, cutoff — sab ek jagah milega</p>
        </div>
        <div class="home-how-step">
          <div class="home-how-num">3</div>
          <h3>Apply Karo</h3>
          <p>Direct apply link se official portal pe jao aur form bharo</p>
        </div>
        <div class="home-how-step">
          <div class="home-how-num">4</div>
          <h3>Track Karo</h3>
          <p>Admit card, answer key, result — sab yahan pe check karte raho</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== COMPARE BUTTON ========== -->
  <section class="home-sec home-compare-sec">
    <div class="container" style="text-align:center">
      <a href="/competitor-comparison/" class="home-compare-btn">
        <span class="home-compare-icon">⚔️</span>
        <div class="home-compare-text">
          <h3>Hum vs Competitors — Full Comparison</h3>
          <p>SarkariResult, Testbook, Adda247 se kaise compare karte hai — sab dekho</p>
        </div>
        <span class="home-compare-arrow">→</span>
      </a>
    </div>
  </section>

  <!-- ========== RAJASTHAN QUICK ========== -->
  <section class="home-sec" id="raj">
    <div class="container">
      <div class="home-sec-head">
        <h2 class="home-sec-title">🏔️ Rajasthan Services</h2>
        <a href="/rajasthan-services/" class="home-sec-more">View All →</a>
      </div>
      <div class="home-raj-grid">
        <a href="/raj/sso/" class="home-rk-item">🔐 SSO Portal</a>
        <a href="/raj/e-mitra/" class="home-rk-item">🏪 e-Mitra</a>
        <a href="/raj/bhu-naksha/" class="home-rk-item">🗺️ Bhu-Naksha</a>
        <a href="/raj/jan-aadhaar/" class="home-rk-item">🪪 Jan Aadhaar</a>
        <a href="/raj/rbse-board/" class="home-rk-item">🏫 RBSE Board</a>
        <a href="/raj/chiranjeevi-yojana/" class="home-rk-item">🏥 Chiranjeevi</a>
      </div>
    </div>
  </section>

  <!-- DISCLAIMER -->
  <div class="disclaimer-band">
    <div class="container">
      <div class="disclaimer">
        <span class="disc-icon">⚠️</span>
        <p class="disc-text">
          <strong>Disclaimer:</strong> सरकारी सहायक एक educational portal है। यहाँ दी गई जानकारी सरकारी वेबसाइटों से ली गई है। हम किसी भी सरकारी विभाग से जुड़े नहीं हैं। <a href="/disclaimer/" style="color:var(--saffron);text-decoration:underline">पूरा disclaimer पढ़ें</a>।
        </p>
      </div>
    </div>
  </div>



  <!-- ========== SCRIPTS ========== -->
  <script is:inline>
  (function() {
    // Social Proof Counter
    var spEl = document.getElementById('socialProofText');
    if (spEl) {
      var base = 1247;
      var today = new Date();
      var seed = today.getFullYear() * 10000 + (today.getMonth() + 1) * 100 + today.getDate();
      var count = base + (seed % 500) + Math.floor(Math.random() * 200);
      spEl.textContent = 'Aaj ' + count.toLocaleString('en-IN') + ' logon ne apply kiya — aap bhi karein!';
    }

    // Countdown Timer (1s live real-time ticking)
    var countdownCards = document.querySelectorAll('.countdown-card[data-date]');
    function updateCountdowns() {
      var now = Date.now();
      countdownCards.forEach(function(card) {
        var target = new Date(card.getAttribute('data-date')).getTime();
        var diff = target - now;
        if (diff <= 0) {
          var dEl = card.querySelector('[data-unit="days"]'); if (dEl) dEl.textContent = '00';
          var hEl = card.querySelector('[data-unit="hours"]'); if (hEl) hEl.textContent = '00';
          var mEl = card.querySelector('[data-unit="mins"]'); if (mEl) mEl.textContent = '00';
          var sEl = card.querySelector('[data-unit="secs"]'); if (sEl) sEl.textContent = '00';
          return;
        }
        var days = Math.floor(diff / 86400000);
        var hours = Math.floor((diff % 86400000) / 3600000);
        var mins = Math.floor((diff % 3600000) / 60000);
        var secs = Math.floor((diff % 60000) / 1000);
        var dEl = card.querySelector('[data-unit="days"]'); if (dEl) dEl.textContent = String(days).padStart(2, '0');
        var hEl = card.querySelector('[data-unit="hours"]'); if (hEl) hEl.textContent = String(hours).padStart(2, '0');
        var mEl = card.querySelector('[data-unit="mins"]'); if (mEl) mEl.textContent = String(mins).padStart(2, '0');
        var sEl = card.querySelector('[data-unit="secs"]'); if (sEl) sEl.textContent = String(secs).padStart(2, '0');
        var progress = card.querySelector('[data-progress]');
        if (progress) {
          var totalDays = 180;
          var elapsed = totalDays - days;
          var pct = Math.min(100, Math.max(2, (elapsed / totalDays) * 100));
          progress.style.width = pct + '%';
        }
      });
    }
    updateCountdowns();
    setInterval(updateCountdowns, 1000);

    // Trending: localStorage view counts
    var jobs = [
      { slug: 'ssc-cgl-2026', title: 'SSC CGL 2026', org: 'Staff Selection Commission', cat: 'central', vacancies: '18000+' },
      { slug: 'rrb-ntpc-2026', title: 'RRB NTPC 2026', org: 'Railway Recruitment Board', cat: 'railway', vacancies: '35000+' },
      { slug: 'ibps-clerk-xiii', title: 'IBPS Clerk XIII', org: 'Institute of Banking Personnel', cat: 'banking', vacancies: '6000+' },
      { slug: 'upsc-cse-2026', title: 'UPSC CSE 2026', org: 'Union Public Service Commission', cat: 'central', vacancies: '1000+' },
      { slug: 'rajasthan-police-2026', title: 'Rajasthan Police 2026', org: 'Rajasthan Police', cat: 'rajasthan', vacancies: '5000+' },
      { slug: 'upsssc-argument-clerk', title: 'UPSSSC Arg Clerk 2026', org: 'UPSSSC', cat: 'state', vacancies: '4000+' },
      { slug: 'indian-army-agniveer', title: 'Agniveer Rally 2026', org: 'Indian Army', cat: 'defence', vacancies: '25000+' },
    ];

    // Increment view count per job
    var views = {};
    try { views = JSON.parse(localStorage.getItem('ss_job_views') || '{}'); } catch(e) {}
    var slug = window.location.pathname.split('/').filter(Boolean).pop();
    if (slug && slug.length > 3) {
      views[slug] = (views[slug] || 0) + 1;
      try { localStorage.setItem('ss_job_views', JSON.stringify(views)); } catch(e) {}
    }

    // Merge with base counts
    jobs.forEach(function(j) {
      j.views = (views[j.slug] || 0) + Math.floor(Math.random() * 50) + 10;
    });
    jobs.sort(function(a, b) { return b.views - a.views; });

    var grid = document.getElementById('trendingGrid');
    if (grid) {
      grid.innerHTML = jobs.slice(0, 6).map(function(j, i) {
        return '<a href="/latest-jobs/' + j.slug + '/" class="trending-card">' +
          '<div class="tr-rank">#' + (i + 1) + '</div>' +
          '<div class="tr-body">' +
            '<h3 class="tr-title">' + j.title + '</h3>' +
            '<p class="tr-org">' + j.org + '</p>' +
          '</div>' +
          '<div class="tr-right">' +
            '<span class="tr-views">👁️ ' + j.views.toLocaleString('en-IN') + '</span>' +
            '<span class="tr-vac">' + j.vacancies + ' Posts</span>' +
          '</div>' +
        '</a>';
      }).join('');
    }
  })();
  </script>

