    /* ==========================================================
       LIVE SEARCH + CATEGORY FILTER ENGINE
       ========================================================== */
    var state = { q: '', filter: 'all' };
    var items = Array.prototype.slice.call(document.querySelectorAll('.searchable'));

    function applyFilters() {
      var q = state.q.toLowerCase().trim(), f = state.filter, visTotal = 0;
      items.forEach(function (el) {
        var hay = (el.textContent + ' ' + (el.getAttribute('data-kw') || '')).toLowerCase();
        var cat = el.getAttribute('data-cat') || '';
        var visible = (!q || hay.indexOf(q) !== -1) && ((f === 'all') || cat === f);
        el.classList.toggle('hide-item', !visible);
        if (visible) visTotal++;
      });
      ['national', 'rajasthan', 'guides'].forEach(function (secId) {
        var sec = document.getElementById(secId);
        var grid = sec.querySelector('.services-grid,.raj-grid,.guide-list');
        var any = false;
        Array.prototype.forEach.call(grid.children, function (c) {
          if (!c.classList.contains('hide-item')) any = true;
        });
        sec.classList.toggle('section-hidden', !any);
      });
      var natHidden = document.getElementById('national').classList.contains('section-hidden');
      var divNR = document.querySelector('#national + .m-stripe');
      if (divNR) divNR.classList.toggle('section-hidden', natHidden);
      var searching = (q !== '' || f !== 'all');
      var empty = document.getElementById('globalEmpty');
      empty.classList.toggle('section-hidden', !(searching && visTotal === 0));
      document.getElementById('filterNote').textContent =
        searching ? (visTotal + ' result(s) mile 👆 card par click karke poori guide kholein') : '';
      forceRevealAll();
    }

    function setFilter(f) {
      state.filter = f;
      document.querySelectorAll('#chipBar .chip').forEach(function (chip) {
        chip.classList.toggle('active', chip.getAttribute('data-filter') === f);
      });
      applyFilters();
    }

    /* chip counts */
    document.querySelectorAll('#chipBar .chip').forEach(function (chip) {
      var f = chip.getAttribute('data-filter');
      var n = f === 'all' ? items.length :
        items.filter(function (el) { return el.getAttribute('data-cat') === f; }).length;
      var cnt = chip.querySelector('.cnt');
      if (cnt) cnt.textContent = '(' + n + ')';
    });

    /* ================= SEARCH SUGGEST ================= */
    var searchForm = document.getElementById('searchForm'),
        searchInput = document.getElementById('searchInput'),
        suggestBox = document.getElementById('searchSuggest'),
        searchWrap = suggestBox.parentElement;

    var SUG = [];
    Object.keys(DATA).forEach(function (id) {
      var d = DATA[id];
      SUG.push({ id: id, gid: '', icon: d.icon, label: d.hi, sub: d.en, type: 'Service' });
    });
    Object.keys(GUIDES).forEach(function (k) {
      SUG.push({ id: GUIDES[k].open, gid: k, icon: '📌', label: GUIDES[k].title, sub: 'Guide', type: 'Guide' });
    });
    var curHits = [];

    function buildSuggest(val) {
      var q = val.trim().toLowerCase();
      if (!q) { hideSuggest(); return; }
      curHits = SUG.filter(function (s) {
        return (s.label + ' ' + s.sub).toLowerCase().indexOf(q) !== -1;
      }).slice(0, 6);
      if (!curHits.length) {
        suggestBox.innerHTML = '<div class="sg-empty">Kuch nahi mila — spelling check karein ya simple word try karein</div>';
        suggestBox.classList.add('open');
        return;
      }
      suggestBox.innerHTML = curHits.map(function (s, i) {
        return '<button type="button" class="sg-item" data-si="' + i + '">' +
          '<span class="sg-icon">' + s.icon + '</span>' +
          '<span class="sg-label">' + esc(s.label) + '<br><small style="color:var(--muted);font-weight:300">' + esc(s.sub) + '</small></span>' +
          '<span class="sg-type">' + s.type + '</span></button>';
      }).join('');
      suggestBox.classList.add('open');
    }
    function hideSuggest() { suggestBox.classList.remove('open'); }

    searchInput.addEventListener('input', function () {
      state.q = searchInput.value;
      applyFilters();
      buildSuggest(searchInput.value);
    });
    searchInput.addEventListener('focus', function () {
      if (state.q.trim()) buildSuggest(state.q);
    });
    searchForm.addEventListener('submit', function (e) {
      e.preventDefault();
      hideSuggest();
      var t = document.getElementById('national');
      if (t) t.scrollIntoView({ behavior: RM ? 'auto' : 'smooth' });
    });
    suggestBox.addEventListener('mousedown', function (e) { e.preventDefault(); });
    suggestBox.addEventListener('click', function (e) {
      var b = e.target.closest('.sg-item');
      if (!b) return;
      var s = curHits[parseInt(b.getAttribute('data-si'), 10)];
      if (!s) return;
      hideSuggest();
      searchInput.blur();
      openDetail(s.id, s.gid);
    });
    document.addEventListener('click', function (e) {
      if (!searchWrap.contains(e.target)) hideSuggest();
    });

    /* ================= GLOBAL CLICK ROUTER ================= */
    document.addEventListener('click', function (e) {
      var t;
      if ((t = e.target.closest('[data-open]'))) {
        e.preventDefault();
        openDetail(t.getAttribute('data-open'), t.getAttribute('data-gid') || '');
        return;
      }
      if ((t = e.target.closest('#chipBar .chip'))) {
        setFilter(t.getAttribute('data-filter'));
        return;
      }
      if ((t = e.target.closest('[data-goto]'))) {
        e.preventDefault();
        var sec = document.querySelector(t.getAttribute('data-goto'));
        if (sec) sec.scrollIntoView({ behavior: RM ? 'auto' : 'smooth' });
      }
    });

    /* ================= KEYBOARD SUPPORT ================= */
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        if (suggestBox.classList.contains('open')) { hideSuggest(); return; }
        if (drawerEl.classList.contains('open')) { closeDrawer(); return; }
        closeMenu();
        return;
      }
      if ((e.key === 'Enter' || e.key === ' ') && e.target.getAttribute &&
          e.target.getAttribute('role') === 'button') {
        var t = e.target.closest('[data-open]');
        if (t) {
          e.preventDefault();
          openDetail(t.getAttribute('data-open'), t.getAttribute('data-gid') || '');
        }
      }
    });

    /* ================= FOOTER YEAR ================= */
    var yearEl = document.getElementById('year');
    if (yearEl) yearEl.textContent = String(new Date().getFullYear());

  })();
  </script>

  <!-- Print color fixes for generated documents -->
  <style is:global>
    @media print{
      #printMount{color:#111;background:#fff;font-family:'Hind',sans-serif}
      #printMount .doc-sheet{background:#fff;color:#111;border-color:#333}
      #printMount .tt-table th{background:#efefef;color:#111;border-color:#999}
      #printMount .tt-table td{color:#222;border-color:#999;background:#fff}
      #printMount h4{color:#111 !important}
    }
  </style>
</body>
</html>
