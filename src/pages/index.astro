    }

    /* ================= HASH / RNG (deterministic simulation) ================= */
    function fnv(str) {
      str = String(str);
      var h = 2166136261, i;
      for (i = 0; i < str.length; i++) { h ^= str.charCodeAt(i); h = Math.imul(h, 16777619); }
      return h >>> 0;
    }
    function mkRng(seed) {
      var s = seed >>> 0;
      return function () { s = (Math.imul(s, 1664525) + 1013904223) >>> 0; return s / 4294967296; };
    }

