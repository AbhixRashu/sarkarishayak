      var done = 0;
      boxes.forEach(function (b) { if (b.checked) done++; });
      var bar = document.getElementById('docBar');
      var cnt = document.getElementById('docCount');
      if (bar) bar.style.width = Math.round(done / boxes.length * 100) + '%';
      if (cnt) cnt.textContent = done + '/' + boxes.length + ' ready';
      if (done === boxes.length) toast('🎉 Sab documents tick ho gaye — ab apply karein!');
    }

