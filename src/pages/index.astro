    drawerContent.addEventListener('change', function (e) {
      if (e.target.classList.contains('doc-check')) updateDocProgress();
      if (e.target.id === 'rbMode') toggleRMode(e.target.value);
    });

    drawerContent.addEventListener('click', function (e) {
      var b = e.target.closest('[data-action]');
      if (!b) return;
      var a = b.getAttribute('data-action');
      if (a === 'tab') activateTab(b.getAttribute('data-tab'));
      else if (a === 'gen-result') doGenResult();
      else if (a === 'gen-admit') doGenAdmit();
      else if (a === 'paper') downloadPaper(parseInt(b.getAttribute('data-i'), 10));
      else if (a === 'calc-pp') calcPP();
      else if (a === 'calc-dl') calcDL();
      else if (a === 'copy') copyLink();
      else if (a === 'share') sharePage();
      else if (a === 'print-sel') printSel(b.getAttribute('data-sel'));
    });

    function activateTab(name) {
      drawerContent.querySelectorAll('.tab-btn').forEach(function (btn) {
        btn.classList.toggle('active', btn.getAttribute('data-tab') === name);
      });
      drawerContent.querySelectorAll('.tab-panel').forEach(function (p) {
        p.classList.toggle('active', p.getAttribute('data-panel') === name);
      });
    }

    function toggleRMode(v) {
      var rr = document.getElementById('rbRollRow'), nr = document.getElementById('rbNameRow');
      if (!rr || !nr) return;
      rr.style.display = v === 'roll' ? 'flex' : 'none';
      nr.style.display = v === 'name' ? 'flex' : 'none';
    }

    /* ================= ACTION IMPLEMENTATIONS ================= */
    function doGenResult() {
      var cls = document.getElementById('rbCls').value;
      var mode = document.getElementById('rbMode').value;
      var rollEl = document.getElementById('rbRoll'), nameEl = document.getElementById('rbName');
      var seed;
      if (mode === 'roll') {
        seed = (rollEl.value || '').trim();
        if (!seed) { toast('Roll Number daalein', 'warn'); rollEl.focus(); return; }
      } else {
        seed = (nameEl.value || '').trim().toLowerCase();
        if (!seed) { toast('Student ka naam daalein', 'warn'); nameEl.focus(); return; }
      }
      var res = genResult(cls, seed);
      var out = document.getElementById('rbOut');
      out.innerHTML =
        '<div style="margin-bottom:12px"><span class="status-line ok">● SIMULATED Result · ' + esc(res.name) + ' · ' + res.pct + '%</span></div>' +
        marksheetHTML(res, cls);
      toast('📊 Simulation result ready — 🖨️ Print se PDF save karein', 'info');
      setTimeout(function () { out.scrollIntoView({ behavior: RM ? 'auto' : 'smooth', block: 'nearest' }); }, 60);
    }

