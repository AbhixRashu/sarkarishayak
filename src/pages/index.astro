    function grade(m) {
      return m >= 91 ? 'A1' : m >= 81 ? 'A2' : m >= 71 ? 'B1' : m >= 61 ? 'B2' : m >= 51 ? 'C1' : m >= 41 ? 'C2' : m >= 33 ? 'D' : 'E';
    }

    function genResult(cls, seedStr) {
      var r = mkRng(fnv(String(seedStr) + '::' + cls));
      var li = Math.floor(r() * LASTF.length),
          fi = Math.floor(r() * FIRST.length),
          ff = Math.floor(r() * FIRST.length);
      var name   = FIRST[fi] + ' ' + LASTF[li];
      var father = FIRST[ff] + ' ' + LASTF[li];
      var school = SCHOOLS[Math.floor(r() * SCHOOLS.length)];
      var subs = SUBJECTS[cls], rows = [], total = 0, failed = false;
      subs.forEach(function (sub) {
        var m = Math.round(33 + r() * 63); if (m > 98) m = 98;
        if (r() < 0.07) { m = Math.max(11, m - 22); }
        total += m; if (m < 33) failed = true;
        rows.push({ s: sub, m: m, g: grade(m) });
      });
      var max = subs.length * 100;
      var pct = (total / max * 100).toFixed(1);
      var div = failed ? '—'
              : Number(pct) >= 60 ? 'प्रथम श्रेणी (First Division)'
              : Number(pct) >= 45 ? 'द्वितीय श्रेणी (Second Division)'
              : 'तृतीय श्रेणी (Third Division)';
      var roll = (cls === '10' ? 'N-' : 'S-') + (1000000 + fnv(seedStr) % 9000000);
      return { name: name, father: father, school: school, roll: roll,
               rows: rows, total: total, max: max, pct: pct, failed: failed, div: div };
    }

