---
import BaseLayout from '../../layouts/BaseLayout.astro';
import admitCards from '../../data/admit-cards.json';
---

<BaseLayout
  title="Latest Admit Card 2026 | Hall Ticket Download | Sarkari Sahayak"
  description="2026 के सभी Latest Admit Cards — IBPS, Railway RRB, NTA, SSC, UPSC, RSSB। Hall Ticket download karein, exam date check karein। Admit Card 2026।"
  canonical="/admit-cards"
>
  <section class="section">
    <div class="container">
      <div class="section-head center-head">
        <span class="section-label">Admit Card 2026</span>
        <h1 class="section-title">Latest Admit Cards</h1>
        <p class="section-sub">Hall tickets &amp; application status — exam se pehle download karein</p>
      </div>

      <div class="guide-list" style="margin-top:var(--sp-xl)">
        {admitCards.map((card, i) => (
          <a href={`/admit-cards/${card.slug}`} class="guide-item">
            <span class="guide-num">{i + 1}</span>
            <div class="guide-body">
              <span class="guide-title">{card.title}</span>
              <div class="guide-tags">
                <span class="gtag gtag-cat">{card.organization}</span>
                <span class="gtag gtag-time">Release: {card.releaseDate}</span>
                <span class="gtag" style="color:var(--success);border-color:rgba(15,163,54,.4)">Exam: {card.examDate}</span>
              </div>
            </div>
            <span class="guide-arrow">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
