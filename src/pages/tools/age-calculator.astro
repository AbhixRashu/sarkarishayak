      rssb_je: { name: 'RSSB JE', min: 18, max: 40, cutoff: '2026-08-01' }
    };

    const relax = { general: 0, obc: 3, sc: 5, st: 5, ews: 0, ph: 10 };

    const examSelect = document.getElementById('examSelect');
    examSelect.addEventListener('change', () => {
      const val = examSelect.value;
      if (val && exams[val]) {
        document.getElementById('cutoffInput').value = exams[val].cutoff;
      }
    });

    document.getElementById('calcBtn').addEventListener('click', () => {
      const dob = document.getElementById('dobInput').value;
      const cutoff = document.getElementById('cutoffInput').value;
      const cat = document.getElementById('catInput').value;
      if (!dob || !cutoff) { alert('DOB aur Cutoff date dono daalein!'); return; }

      const dobDate = new Date(dob);
      const cutoffDate = new Date(cutoff);
      const age = calcAge(dobDate, cutoffDate);

      document.getElementById('ageResult').style.display = 'block';
      document.getElementById('arYears').textContent = age.years;
      document.getElementById('arMonths').textContent = age.months + ' months';
      document.getElementById('arDays').textContent = age.days + ' days';

      const catRelax = relax[cat] || 0;
      const eligGrid = document.getElementById('eligGrid');
      eligGrid.innerHTML = '';

      Object.values(exams).forEach(exam => {
        const maxAge = exam.max + catRelax;
        const isEligible = age.years >= exam.min && age.years <= maxAge;
        const isNear = !isEligible && age.years === maxAge + 1;
        const status = isEligible ? 'pass' : isNear ? 'near' : 'fail';
        const statusText = isEligible ? '✅ Eligible' : isNear ? '⚠️ 1 saal se zyada' : '❌ Not Eligible';

        eligGrid.innerHTML += `
          <div class="elig-card ${status}">
            <div>
              <div class="elig-exam">${exam.name}</div>
              <div class="elig-age">Age: ${exam.min}-${maxAge} years (Cutoff: ${exam.cutoff})</div>
            </div>
            <span class="elig-status ${status}">${statusText}</span>
          </div>
        `;
      });

      document.getElementById('eligTable').style.display = 'block';
    });

    function calcAge(dob, cutoff) {
      let years = cutoff.getFullYear() - dob.getFullYear();
      let months = cutoff.getMonth() - dob.getMonth();
      let days = cutoff.getDate() - dob.getDate();
      if (days < 0) { months--; days += new Date(cutoff.getFullYear(), cutoff.getMonth(), 0).getDate(); }
      if (months < 0) { years--; months += 12; }
      return { years, months, days };
    }
  })();
  </script>
