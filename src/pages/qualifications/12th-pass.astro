  <script is:inline>
  function filterJobs() {
    var stateVal = document.getElementById('stateSelect').value;
    var catVal = document.getElementById('catSelect').value;
    var rows = document.querySelectorAll('#twelveJobsTable tbody tr');
    rows.forEach(function(row) {
      var matchState = stateVal === 'all' || row.getAttribute('data-state') === stateVal;
      var matchCat = catVal === 'all' || row.getAttribute('data-category') === catVal;
      row.style.display = (matchState && matchCat) ? '' : 'none';
    });
  }
  function sortJobs() {
    var sortVal = document.getElementById('sortSelect').value;
    var tbody = document.querySelector('#twelveJobsTable tbody');
    var rows = Array.from(tbody.querySelectorAll('tr'));
    rows.sort(function(a, b) {
      if (sortVal === 'closing') {
        var da = a.getAttribute('data-lastdate') || 'zzz';
        var db = b.getAttribute('data-lastdate') || 'zzz';
        return da.localeCompare(db);
      }
      if (sortVal === 'salary') {
        return (parseInt(b.getAttribute('data-vacancies')) || 0) - (parseInt(a.getAttribute('data-vacancies')) || 0);
      }
      return 0;
    });
    rows.forEach(function(r) { tbody.appendChild(r); });
  }
  </script>
