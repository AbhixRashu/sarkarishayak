---
import BaseLayout from '../../layouts/BaseLayout.astro';
import jobs from '../../data/latest-jobs.json';

const siteUrl = 'https://govtjob.salarypitcher.com';

const filteredJobs = jobs.filter(j => {
  const q = (j.qualify + ' ' + (j.eligibility?.map(e => e.details).join(' ') || '')).toLowerCase();
  return q.includes('12th') || q.includes('higher secondary') || q.includes('10+2');
});

const totalVacancies = filteredJobs.reduce((sum, j) => sum + (j.vacancies || 0), 0);

function parseDate(d: string): Date | null {
  if (!d || d.toLowerCase().includes('check official') || d.toLowerCase().includes('soon')) return null;
  const parts = d.split('/');
  if (parts.length === 3) {
    const [dd, mm, yyyy] = parts.map(Number);
    if (yyyy && mm && dd) return new Date(yyyy, mm - 1, dd);
  }
  const iso = new Date(d);
  return isNaN(iso.getTime()) ? null : iso;
}

const now = new Date();

const jobsWithDates = filteredJobs.map(j => ({
  ...j,
  _lastDateObj: parseDate(j.lastDate),
  _postDateObj: parseDate(j.postDate),
}));

const openJobs = jobsWithDates.filter(j => {
  if (!j._lastDateObj) return true;
  return j._lastDateObj >= now;
});

const closingSoon = openJobs
  .filter(j => j._lastDateObj && j._lastDateObj >= now)
  .sort((a, b) => a._lastDateObj!.getTime() - b._lastDateObj!.getTime())
  .slice(0, 10);

const latestJobs = [...jobsWithDates]
  .sort((a, b) => (b._postDateObj?.getTime() || 0) - (a._postDateObj?.getTime() || 0))
  .slice(0, 10);

const highestSalary = [...openJobs]
  .sort((a, b) => b.vacancies - a.vacancies)
  .slice(0, 8);

const centralJobs = openJobs.filter(j => j.category === 'central' || j.category === 'ssc').slice(0, 8);
const stateJobs = openJobs.filter(j => j.category === 'state' || j.category === 'rajasthan' || j.category === 'psc').slice(0, 8);
const policeJobs = openJobs.filter(j => j.category === 'police' || j.category === 'defence' || j.title.toLowerCase().includes('police') || j.title.toLowerCase().includes('constable')).slice(0, 8);
const railwayJobs = openJobs.filter(j => j.category === 'railway' || j.title.toLowerCase().includes('railway') || j.title.toLowerCase().includes('rrb')).slice(0, 8);
const sscJobs = openJobs.filter(j => j.category === 'ssc' || j.title.toLowerCase().includes('ssc')).slice(0, 8);
const onlineFormJobs = openJobs.filter(j => j.applyUrl && j.applyUrl !== '#').slice(0, 8);

const states = [...new Set(filteredJobs.map(j => j.state).filter(Boolean))].sort();
const categories = [...new Set(filteredJobs.map(j => j.category))].sort();

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl + "/" },
    { "@type": "ListItem", "position": 2, "name": "Qualifications", "item": siteUrl + "/qualifications/" },
    { "@type": "ListItem", "position": 3, "name": "12th Pass Govt Jobs 2026", "item": siteUrl + "/qualifications/12th-pass/" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Which government jobs are available after 12th pass?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "After 12th pass, candidates can apply for SSC CHSL (LDC, DEO, Postal Assistant), SSC Stenographer, SSC Selection Post, Delhi Police Constable, BSF/CRPF/CISF Head Constable, Indian Navy SSR/AA, Indian Air Force Agniveer Vayu, Indian Army Agniveer, RRB NTPC Undergraduate, UPSSSC PET, State Police Constable, and many more government jobs."
      }
    },
    {
      "@type": "Question",
      "name": "Which 12th pass govt jobs are currently open?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Currently open 12th pass government jobs include SSC CHSL 2026 (12,000 posts), SSC Stenographer (1,200 posts), Delhi Police Constable (5,000+ posts), BSF Head Constable (1,500+ posts), Indian Navy Agniveer SSR (8,000 posts), Indian Air Force Agniveer Vayu, RRB NTPC UG, and multiple state police constable recruitments. Check the listings above for exact last dates and apply links."
      }
    },
    {
      "@type": "Question",
      "name": "How can I apply for a 12th pass government job online?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To apply online for 12th pass government jobs: 1) Visit the official website mentioned in the notification (ssc.nic.in for SSC exams, joinindiannavy.gov.in for Navy, etc.). 2) Register with a valid email and mobile number. 3) Fill the online application form. 4) Upload required documents (photo, signature, certificates). 5) Pay the application fee online. 6) Submit and download the confirmation page."
      }
    },
    {
      "@type": "Question",
      "name": "Which 12th pass government jobs have the highest salary?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The highest salary 12th pass government jobs include: UPSC NDA (Officer rank, Level-10, Rs. 56,100+ starting), SSC CHSL DEO (Level-4, Rs. 25,500-81,100), Indian Coast Guard Navik, BSF/CISF ASI Steno (Level-5, Rs. 29,200-92,300), and Delhi Police Head Constable Ministerial (Level-4). Armed forces Agniveer positions also offer Rs. 30,000-40,000 monthly stipend."
      }
    },
    {
      "@type": "Question",
      "name": "What is the age limit for 12th pass govt jobs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Age limits vary by job: SSC CHSL — 18-27 years, Delhi Police Constable — 18-25 years, BSF/CRPF Head Constable — 18-25 years, Indian Navy SSR — 17-21 years, Agniveer Vayu — 17-23 years, RRB NTPC UG — 18-30 years, State Police Constable — 18-25 years (varies by state). Age relaxation applies for SC/ST (5 years), OBC (3 years), PwD (10 years), and Ex-servicemen as per government rules."
      }
    },
    {
      "@type": "Question",
      "name": "Are there 12th pass government jobs in Rajasthan?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, Rajasthan offers multiple 12th pass government jobs including Rajasthan Police Constable (15,000+ posts), RPSC Hospital Assistant, RSSB various posts, and Rajasthan State PSC recruitments. Candidates from Rajasthan can also apply for all India SSC, Railway, and Defence jobs."
      }
    }
  ]
};

const faqSchemaHindi = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "12th pass ke liye kaun kaun si government jobs hoti hain?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "12th pass candidates SSC CHSL, SSC Stenographer, SSC Selection Post, Delhi Police Constable, BSF/CRPF/CISF Head Constable, Indian Navy SSR/AA, Air Force Agniveer Vayu, Army Agniveer, RRB NTPC UG, UPSSSC PET, State Police Constable jaisi government jobs ke liye apply kar sakte hain."
      }
    },
    {
      "@type": "Question",
      "name": "12th pass government job ki salary kitni hoti hai?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "12th pass government jobs mein salary post ke hisaab se alag hoti hai. SSC CHSL LDC mein Rs. 19,900-63,200 (Level-2), DEO mein Rs. 25,500-81,100 (Level-4), NDA mein Rs. 56,100 (Level-10), Navy SSR mein Rs. 21,700-69,100 (Level-3) milta hai. Agniveer mein Rs. 30,000-40,000 monthly stipend milta hai."
      }
    },
    {
      "@type": "Question",
      "name": "12th pass govt job ki age limit kya hoti hai?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Age limit job ke hisaab se alag hoti hai: SSC CHSL — 18-27, Delhi Police — 18-25, BSF/CRPF HC — 18-25, Navy SSR — 17-21, Agniveer Vayu — 17-23, RRB NTPC — 18-30, State Police — 18-25 years. SC/ST ko 5 saal, OBC ko 3 saal, PwD ko 10 saal ki relaxation milti hai."
      }
    }
  ]
};
---

<BaseLayout
  title="12th Pass Govt Jobs 2026 – Latest Vacancy, Online Form & Salary"
  description="Find the latest 12th Pass Govt Jobs 2026 with vacancy, salary, eligibility, age limit, last date, selection process and official apply links. Updated regularly."
  canonical="/qualifications/12th-pass/"
  keywords="12th pass govt job, 12th pass govt job online form, 12 pass govt job vacancy, 12th pass government job vacancy, sarkari job for 12th pass, 12th pass government jobs 2026, 12th pass govt jobs online apply, 12th pass govt jobs with salary, 12th pass govt jobs latest vacancy"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchemaHindi)} />
  </Fragment>

  <div class="section" style="padding-bottom:0">
    <div class="container">
      <nav style="font-size:13px;font-weight:300;color:var(--muted);letter-spacing:.5px" aria-label="Breadcrumb">
        <a href="/" style="color:var(--saffron);text-decoration:none">Home</a>
        <span style="margin:0 6px;color:var(--hairline)">/</span>
        <a href="/qualifications" style="color:var(--saffron);text-decoration:none">Qualifications</a>
        <span style="margin:0 6px;color:var(--hairline)">/</span>
        <span style="color:var(--strong)">12th Pass Govt Jobs</span>
      </nav>
    </div>
  </div>

  <section class="section" style="padding-top:var(--sp-lg)">
    <div class="container">

      <div class="section-head center-head">
        <span class="section-label">Sarkari Naukri After 12th</span>
        <h1 class="section-title">12th Pass Govt Jobs 2026</h1>
        <p class="section-sub">Latest 12th pass sarkari naukri — vacancy, salary, eligibility, last date, selection process aur official apply links. Updated daily.</p>
      </div>

      <div class="stats-row" style="margin-bottom:var(--sp-lg)">
        <div class="stat">
          <div class="stat-num">{openJobs.length}</div>
          <div class="stat-label">Open Vacancies</div>
        </div>
        <div class="stat">
          <div class="stat-num">{totalVacancies.toLocaleString('en-IN')}</div>
          <div class="stat-label">Total Posts</div>
        </div>
        <div class="stat">
          <div class="stat-num">18–27</div>
          <div class="stat-label">Typical Age Range</div>
        </div>
      </div>

      <div class="twelve-filters" id="twelveFilters">
        <div class="twelve-filter-row">
          <div class="twelve-filter-group">
            <label class="twelve-filter-label">Sort By</label>
            <select class="twelve-select" id="sortSelect" onchange="sortJobs()">
              <option value="latest">Latest First</option>
              <option value="closing">Closing Soon</option>
              <option value="salary">Highest Vacancies</option>
            </select>
          </div>
          <div class="twelve-filter-group">
            <label class="twelve-filter-label">State</label>
            <select class="twelve-select" id="stateSelect" onchange="filterJobs()">
              <option value="all">All States</option>
              {states.map(s => <option value={s}>{s}</option>)}
            </select>
          </div>
          <div class="twelve-filter-group">
            <label class="twelve-filter-label">Category</label>
            <select class="twelve-select" id="catSelect" onchange="filterJobs()">
              <option value="all">All Categories</option>
              <option value="defence">Defence / Armed Forces</option>
              <option value="central">Central Govt</option>
              <option value="ssc">SSC</option>
              <option value="railway">Railway</option>
              <option value="police">Police</option>
              <option value="state">State Govt</option>
              <option value="rajasthan">Rajasthan</option>
              <option value="psc">State PSC</option>
              <option value="teaching">Teaching</option>
            </select>
          </div>
        </div>
      </div>

      {/* All Filterable Jobs */}
      <div class="twelve-section" id="allJobsSection">
        <div class="twelve-section-head">
          <span class="section-label">All 12th Pass Government Jobs</span>
        </div>
        <div class="tt-wrap">
          <table class="tt-table" id="twelveJobsTable">
            <thead>
              <tr>
                <th style="width:35%">Post / Recruitment</th>
                <th>Organization</th>
                <th style="text-align:center">Vacancies</th>
                <th>Last Date</th>
                <th>Qualification</th>
                <th style="text-align:center">Apply</th>
              </tr>
            </thead>
            <tbody>
              {filteredJobs.map(job => (
                <tr data-category={job.category} data-state={job.state || ''} data-lastdate={job.lastDate || ''} data-vacancies={job.vacancies || 0}>
                  <td>
                    <a href={`/latest-jobs/${job.slug}`} style="color:var(--strong);font-weight:400">{job.title}</a>
                    {job.salary ? <><br/><span style="font-size:12px;color:var(--muted)">{job.salary}</span></> : null}
                  </td>
                  <td style="white-space:nowrap">{job.organization}</td>
                  <td style="text-align:center;font-family:var(--font-display);font-weight:700;color:var(--gold)">
                    {job.vacancies > 0 ? job.vacancies.toLocaleString('en-IN') : '—'}
                  </td>
                  <td style="white-space:nowrap;font-family:var(--font-display);font-weight:600">{job.lastDate}</td>
                  <td style="font-size:12px;color:var(--muted)">{job.qualify}</td>
                  <td style="text-align:center">
                    <a href={job.applyUrl} target="_blank" rel="noopener" class="btn-ghost" style="height:36px;padding:0 14px;font-size:11px">
                      Apply ↗
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      {/* 🔥 Latest 12th Pass Govt Jobs */}
      {latestJobs.length > 0 && (
        <div class="twelve-section">
          <div class="twelve-section-head">
            <span class="section-label">🔥 Latest 12th Pass Govt Jobs</span>
          </div>
          <div class="twelve-cards">
            {latestJobs.map(job => (
              <a href={`/latest-jobs/${job.slug}`} class="twelve-card">
                <div class="twelve-card-top">
                  <span class="twelve-card-cat">{job.category}</span>
                  {job.vacancies > 0 && <span class="twelve-card-vac">{job.vacancies.toLocaleString('en-IN')} Posts</span>}
                </div>
                <h3 class="twelve-card-title">{job.shortTitle || job.title}</h3>
                <p class="twelve-card-org">{job.organization}</p>
                <div class="twelve-card-meta">
                  {job.lastDate && <span>📅 Last Date: {job.lastDate}</span>}
                  {job.ageMax && <span>🎂 Age: {job.ageMin}-{job.ageMax} yrs</span>}
                </div>
                <div class="twelve-card-footer">
                  <span class="twelve-card-qualify">{job.qualify}</span>
                  {job.applyUrl && job.applyUrl !== '#' && <span class="twelve-card-apply">Apply Online ↗</span>}
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      {/* ⏰ Closing Soon */}
      {closingSoon.length > 0 && (
        <div class="twelve-section">
          <div class="twelve-section-head">
            <span class="section-label">⏰ Closing Soon — Apply Before Last Date</span>
          </div>
          <div class="twelve-cards">
            {closingSoon.map(job => (
              <a href={`/latest-jobs/${job.slug}`} class="twelve-card twelve-card-urgent">
                <div class="twelve-card-top">
                  <span class="twelve-card-urgent-badge">Closing Soon</span>
                  <span class="twelve-card-cat">{job.category}</span>
                </div>
                <h3 class="twelve-card-title">{job.shortTitle || job.title}</h3>
                <p class="twelve-card-org">{job.organization}</p>
                <div class="twelve-card-meta">
                  {job.lastDate && <span>📅 Last Date: {job.lastDate}</span>}
                  {job.vacancies > 0 && <span>👥 {job.vacancies.toLocaleString('en-IN')} Posts</span>}
                </div>
                <div class="twelve-card-footer">
                  <span class="twelve-card-qualify">{job.qualify}</span>
                  {job.applyUrl && job.applyUrl !== '#' && <span class="twelve-card-apply">Apply Now ↗</span>}
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      {/* 💰 Highest Vacancies */}
      {highestSalary.length > 0 && (
        <div class="twelve-section">
          <div class="twelve-section-head">
            <span class="section-label">💰 Highest Vacancies</span>
          </div>
          <div class="twelve-cards">
            {highestSalary.map(job => (
              <a href={`/latest-jobs/${job.slug}`} class="twelve-card">
                <div class="twelve-card-top">
                  <span class="twelve-card-cat">{job.category}</span>
                  {job.vacancies > 0 && <span class="twelve-card-vac">{job.vacancies.toLocaleString('en-IN')} Posts</span>}
                </div>
                <h3 class="twelve-card-title">{job.shortTitle || job.title}</h3>
                <p class="twelve-card-org">{job.organization}</p>
                <div class="twelve-card-meta">
                  {job.lastDate && <span>📅 Last Date: {job.lastDate}</span>}
                  {job.ageMax && <span>🎂 Age: {job.ageMin}-{job.ageMax} yrs</span>}
                </div>
                <div class="twelve-card-footer">
                  <span class="twelve-card-qualify">{job.qualify}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      {/* 🏛 Central Government Jobs */}
      {centralJobs.length > 0 && (
        <div class="twelve-section">
          <div class="twelve-section-head">
            <span class="section-label">🏛 Central Government Jobs</span>
          </div>
          <div class="twelve-cards">
            {centralJobs.map(job => (
              <a href={`/latest-jobs/${job.slug}`} class="twelve-card">
                <div class="twelve-card-top">
                  <span class="twelve-card-cat">{job.category}</span>
                  {job.vacancies > 0 && <span class="twelve-card-vac">{job.vacancies.toLocaleString('en-IN')} Posts</span>}
                </div>
                <h3 class="twelve-card-title">{job.shortTitle || job.title}</h3>
                <p class="twelve-card-org">{job.organization}</p>
                <div class="twelve-card-meta">
                  {job.lastDate && <span>📅 Last Date: {job.lastDate}</span>}
                </div>
                <div class="twelve-card-footer">
                  <span class="twelve-card-qualify">{job.qualify}</span>
                  {job.applyUrl && job.applyUrl !== '#' && <span class="twelve-card-apply">Apply ↗</span>}
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      {/* 🏢 State Government Jobs */}
      {stateJobs.length > 0 && (
        <div class="twelve-section">
          <div class="twelve-section-head">
            <span class="section-label">🏢 State Government Jobs</span>
          </div>
          <div class="twelve-cards">
            {stateJobs.map(job => (
              <a href={`/latest-jobs/${job.slug}`} class="twelve-card">
                <div class="twelve-card-top">
                  <span class="twelve-card-cat">{job.category}</span>
                  {job.state && <span class="twelve-card-state">{job.state}</span>}
                </div>
                <h3 class="twelve-card-title">{job.shortTitle || job.title}</h3>
                <p class="twelve-card-org">{job.organization}</p>
                <div class="twelve-card-meta">
                  {job.lastDate && <span>📅 Last Date: {job.lastDate}</span>}
                  {job.vacancies > 0 && <span>👥 {job.vacancies.toLocaleString('en-IN')} Posts</span>}
                </div>
                <div class="twelve-card-footer">
                  <span class="twelve-card-qualify">{job.qualify}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      {/* 👮 Police Jobs */}
      {policeJobs.length > 0 && (
        <div class="twelve-section">
          <div class="twelve-section-head">
            <span class="section-label">👮 Police & Defence Jobs</span>
          </div>
          <div class="twelve-cards">
            {policeJobs.map(job => (
              <a href={`/latest-jobs/${job.slug}`} class="twelve-card">
                <div class="twelve-card-top">
                  <span class="twelve-card-cat">{job.category}</span>
                  {job.vacancies > 0 && <span class="twelve-card-vac">{job.vacancies.toLocaleString('en-IN')} Posts</span>}
                </div>
                <h3 class="twelve-card-title">{job.shortTitle || job.title}</h3>
                <p class="twelve-card-org">{job.organization}</p>
                <div class="twelve-card-meta">
                  {job.lastDate && <span>📅 Last Date: {job.lastDate}</span>}
                  {job.ageMax && <span>🎂 Age: {job.ageMin}-{job.ageMax} yrs</span>}
                </div>
                <div class="twelve-card-footer">
                  <span class="twelve-card-qualify">{job.qualify}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      {/* 🚆 Railway Jobs */}
      {railwayJobs.length > 0 && (
        <div class="twelve-section">
          <div class="twelve-section-head">
            <span class="section-label">🚆 Railway Jobs</span>
          </div>
          <div class="twelve-cards">
            {railwayJobs.map(job => (
              <a href={`/latest-jobs/${job.slug}`} class="twelve-card">
                <div class="twelve-card-top">
                  <span class="twelve-card-cat">Railway</span>
                  {job.vacancies > 0 && <span class="twelve-card-vac">{job.vacancies.toLocaleString('en-IN')} Posts</span>}
                </div>
                <h3 class="twelve-card-title">{job.shortTitle || job.title}</h3>
                <p class="twelve-card-org">{job.organization}</p>
                <div class="twelve-card-meta">
                  {job.lastDate && <span>📅 Last Date: {job.lastDate}</span>}
                  {job.salary && <span>💰 {job.salary}</span>}
                </div>
                <div class="twelve-card-footer">
                  <span class="twelve-card-qualify">{job.qualify}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      {/* 📋 SSC / Clerk / Office Jobs */}
      {sscJobs.length > 0 && (
        <div class="twelve-section">
          <div class="twelve-section-head">
            <span class="section-label">📋 SSC / Clerk / Office Jobs</span>
          </div>
          <div class="twelve-cards">
            {sscJobs.map(job => (
              <a href={`/latest-jobs/${job.slug}`} class="twelve-card">
                <div class="twelve-card-top">
                  <span class="twelve-card-cat">{job.category}</span>
                  {job.vacancies > 0 && <span class="twelve-card-vac">{job.vacancies.toLocaleString('en-IN')} Posts</span>}
                </div>
                <h3 class="twelve-card-title">{job.shortTitle || job.title}</h3>
                <p class="twelve-card-org">{job.organization}</p>
                <div class="twelve-card-meta">
                  {job.lastDate && <span>📅 Last Date: {job.lastDate}</span>}
                  {job.salary && <span>💰 {job.salary}</span>}
                </div>
                <div class="twelve-card-footer">
                  <span class="twelve-card-qualify">{job.qualify}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      {/* 📝 Jobs with Online Form / Apply Online */}
      {onlineFormJobs.length > 0 && (
        <div class="twelve-section">
          <div class="twelve-section-head">
