{
  "name": "sarkari-sahayak",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "sync": "node src/scripts/live-agent.mjs",
    "agent:live": "node src/scripts/live-agent.mjs --daemon --interval=30",
    "sitemap": "node src/scripts/generate-sitemap.mjs",
    "index:google": "node src/scripts/google-index-ping.mjs",
    "index:sample": "node src/scripts/google-index-ping.mjs --sample=20",
    "index:now": "node src/scripts/indexnow-ping.mjs",
    "index:all": "node src/scripts/generate-sitemap.mjs && node src/scripts/google-index-ping.mjs && node src/scripts/indexnow-ping.mjs",
    "telegram:test": "node src/scripts/telegram-notify.mjs --test",
    "telegram:test:dry": "node src/scripts/telegram-notify.mjs --test --dry-run"
  },
  "dependencies": {
    "@microsoft/clarity": "^1.0.2",
    "astro": "^5.0.0"
  }
}
